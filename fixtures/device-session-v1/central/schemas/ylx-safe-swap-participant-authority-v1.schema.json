{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ylx:schema:safe-swap-participant-authority:v1",
  "title": "YLX Safe-Swap Participant Authority v1",
  "description": "Content-addressed M4 authority for the exact deployed participant-to-volume-access-path map. Its SHA-256 is external and is bound by each integrated safe-swap receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority_scope",
    "binding_context_sha256",
    "deployment_record_sha256",
    "participants"
  ],
  "properties": {
    "schema": {
      "const": "ylx.safe-swap-participant-authority.v1"
    },
    "authority_scope": {
      "const": "m4-qualified-deployment-record"
    },
    "binding_context_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "deployment_record_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participant_id", "access_paths"],
        "properties": {
          "participant_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "access_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/accessPath"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "accessPath": {
      "enum": [
        "capture-seal",
        "gateway-validation",
        "artifact-get-head-range",
        "preview",
        "lan-transfer",
        "media-adapter",
        "worker"
      ]
    }
  }
}
