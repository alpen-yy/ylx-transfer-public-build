{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/delivery-planning-bundle-v1.schema.json",
  "title": "YLX delivery planning bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_id",
    "revision",
    "predecessor_sha256",
    "generated_at",
    "source_refs",
    "approvals",
    "artifact_metadata",
    "artifacts",
    "overall_status"
  ],
  "properties": {
    "schema": {
      "const": "ylx.delivery-planning-bundle.v1"
    },
    "artifact_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor_sha256": {
      "anyOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sourceRef"
      },
      "uniqueItems": true
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/approval"
      },
      "uniqueItems": true
    },
    "artifact_metadata": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactMetadata"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_assignment",
        "resource_calendar",
        "delivery_wbs",
        "forecast_snapshot"
      ],
      "properties": {
        "owner_assignment": {
          "allOf": [
            {
              "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "schema": {
                  "const": "ylx.owner-assignment.v1"
                }
              }
            }
          ]
        },
        "resource_calendar": {
          "allOf": [
            {
              "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "schema": {
                  "const": "ylx.resource-calendar.v1"
                }
              }
            }
          ]
        },
        "delivery_wbs": {
          "allOf": [
            {
              "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "schema": {
                  "const": "ylx.delivery-wbs.v1"
                }
              }
            }
          ]
        },
        "forecast_snapshot": {
          "allOf": [
            {
              "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "schema": {
                  "const": "ylx.forecast-snapshot.v1"
                }
              }
            }
          ]
        }
      }
    },
    "overall_status": {
      "enum": [
        "ACCEPTED",
        "INPUT_BLOCKED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": [
          "revision"
        ]
      },
      "then": {
        "properties": {
          "predecessor_sha256": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "predecessor_sha256": {
            "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "ACCEPTED"
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "properties": {
          "approvals": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
