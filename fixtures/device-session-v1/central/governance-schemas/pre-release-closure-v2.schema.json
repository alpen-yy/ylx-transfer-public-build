{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/pre-release-closure-v2.schema.json",
  "title": "YLX immutable pre-release closure v2",
  "description": "A revisioned pre-signoff 173-row snapshot over the exact release-result projection v2, eleven domain attestations v2, M5 binding context v2, and effective M4 lineage. It is signing input, not release completion or customer visibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "closure_id",
    "revision",
    "predecessor_closure_ref",
    "binding_context_ref",
    "effective_m4_lineage_ref",
    "effective_m4_binding_context_ref",
    "contract_release_sha256",
    "product_contract_sha256",
    "qualification_governance_contract_sha256",
    "registry_sha256",
    "registry_id_set_sha256",
    "registry_cardinality",
    "acceptance_sha256",
    "system_requirement_mapping_artifact_sha256",
    "system_requirement_mapping_semantic_sha256",
    "release_result_projection_ref",
    "release_result_projection_sha256",
    "current_result_map",
    "proposed_final_result_map",
    "issue_head",
    "issue_reconciliation_set_sha256",
    "domain_attestation_ref_by_role_slot",
    "domain_attestation_sha256_by_role_slot",
    "consumer_boundary_registry_sha256",
    "consumer_boundary_acceptance_set_sha256",
    "component_acceptance_record_sha256_by_boundary",
    "signing_policy_ref",
    "signing_policy_sha256",
    "key_validity_revocation_head_ref",
    "key_validity_revocation_head_sha256",
    "quorum_policy_ref",
    "quorum_policy_sha256",
    "ga_promotion_plan_ref",
    "ga_promotion_plan_sha256",
    "planned_promotion_operator",
    "created_at",
    "artifact_metadata"
  ],
  "properties": {
    "schema": {
      "const": "ylx.pre-release-closure.v2"
    },
    "closure_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor_closure_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/preReleaseClosureRef"
        }
      ]
    },
    "binding_context_ref": {
      "$ref": "#/$defs/bindingContextRef"
    },
    "effective_m4_lineage_ref": {
      "$ref": "#/$defs/m4ContextLineageRef"
    },
    "effective_m4_binding_context_ref": {
      "$ref": "#/$defs/bindingContextRef"
    },
    "contract_release_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "product_contract_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "qualification_governance_contract_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "registry_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "registry_id_set_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "registry_cardinality": {
      "const": 173
    },
    "acceptance_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "system_requirement_mapping_artifact_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "system_requirement_mapping_semantic_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "release_result_projection_ref": {
      "$ref": "#/$defs/releaseResultProjectionRef"
    },
    "release_result_projection_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "current_result_map": {
      "$ref": "#/$defs/currentResultMap"
    },
    "proposed_final_result_map": {
      "$ref": "#/$defs/finalResultMap"
    },
    "issue_head": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/issueHead"
    },
    "issue_reconciliation_set_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "domain_attestation_ref_by_role_slot": {
      "$ref": "#/$defs/domainAttestationRefMap"
    },
    "domain_attestation_sha256_by_role_slot": {
      "$ref": "#/$defs/domainAttestationDigestMap"
    },
    "consumer_boundary_registry_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "consumer_boundary_acceptance_set_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "component_acceptance_record_sha256_by_boundary": {
      "$ref": "#/$defs/componentAcceptanceMap"
    },
    "signing_policy_ref": {
      "$ref": "#/$defs/signingPolicyRef"
    },
    "signing_policy_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "key_validity_revocation_head_ref": {
      "$ref": "#/$defs/keyHeadRef"
    },
    "key_validity_revocation_head_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "quorum_policy_ref": {
      "$ref": "#/$defs/quorumPolicyRef"
    },
    "quorum_policy_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "ga_promotion_plan_ref": {
      "$ref": "#/$defs/promotionPlanRef"
    },
    "ga_promotion_plan_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "planned_promotion_operator": {
      "$ref": "https://schemas.ylx.invalid/governance/ga-promotion-plan-v2.schema.json#/$defs/plannedOperator"
    },
    "created_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "artifact_metadata": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactMetadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": [
          "revision"
        ]
      },
      "then": {
        "properties": {
          "predecessor_closure_ref": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 2
          },
          "predecessor_closure_ref": {
            "$ref": "#/$defs/preReleaseClosureRef"
          }
        }
      }
    }
  ],
  "not": {
    "anyOf": [
      {
        "required": [
          "pre_release_closure_sha256"
        ]
      },
      {
        "required": [
          "matrix_verdict_sha256"
        ]
      },
      {
        "required": [
          "external_locator_sha256"
        ]
      },
      {
        "required": [
          "release_publication_fence_ref"
        ]
      },
      {
        "required": [
          "ga_promotion_receipt_ref"
        ]
      },
      {
        "required": [
          "release_closure_manifest_ref"
        ]
      }
    ]
  },
  "$defs": {
    "preReleaseClosureRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.pre-release-closure.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "bindingContextRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.binding-context.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "m4ContextLineageRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.m4-context-lineage.v1"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "releaseResultProjectionRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.release-result-projection.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "domainAttestationRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.domain-attestation.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "signingPolicyRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.m5-signing-policy.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "keyHeadRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.signing-key-validity-revocation-head.v1"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "quorumPolicyRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.release-quorum-policy.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "promotionPlanRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.ga-promotion-plan.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "currentResultMap": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 173,
      "maxProperties": 173,
      "patternProperties": {
        "^[A-Z0-9][A-Z0-9-]+$": {
          "enum": [
            "PASS",
            "N/A",
            "PASS_DERIVED_FROM_PRE_RELEASE_VALIDITY",
            "PENDING_CLOSURE"
          ]
        }
      }
    },
    "finalResultMap": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 173,
      "maxProperties": 173,
      "patternProperties": {
        "^[A-Z0-9][A-Z0-9-]+$": {
          "enum": [
            "PASS",
            "N/A",
            "PASS_DERIVED_FROM_PRE_RELEASE_VALIDITY",
            "PASS_DERIVED_FROM_FINAL_MANIFEST_VALIDITY"
          ]
        }
      }
    },
    "domainAttestationRefMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release-owner",
        "contract-owner",
        "capture-owner",
        "consumer-owner",
        "web-control-owner",
        "network-owner",
        "security-owner",
        "build-platform-owner",
        "qa-evidence-owner",
        "hardware-owner",
        "pipeline-owner"
      ],
      "properties": {
        "release-owner": {
          "$ref": "#/$defs/domainAttestationRef"
        },
        "contract-owner": {
          "$ref": "#/$defs/domainAttestationRef"
        },
        "capture-owner": {
          "$ref": "#/$defs/domainAttestationRef"
        },
        "consumer-owner": {
          "$ref": "#/$defs/domainAttestationRef"
        },
        "web-control-owner": {
          "$ref": "#/$defs/domainAttestationRef"
        },
        "network-owner": {
          "$ref": "#/$defs/domainAttestationRef"
        },
        "security-owner": {
          "$ref": "#/$defs/domainAttestationRef"
        },
        "build-platform-owner": {
          "$ref": "#/$defs/domainAttestationRef"
        },
        "qa-evidence-owner": {
          "$ref": "#/$defs/domainAttestationRef"
        },
        "hardware-owner": {
          "$ref": "#/$defs/domainAttestationRef"
        },
        "pipeline-owner": {
          "$ref": "#/$defs/domainAttestationRef"
        }
      }
    },
    "domainAttestationDigestMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release-owner",
        "contract-owner",
        "capture-owner",
        "consumer-owner",
        "web-control-owner",
        "network-owner",
        "security-owner",
        "build-platform-owner",
        "qa-evidence-owner",
        "hardware-owner",
        "pipeline-owner"
      ],
      "properties": {
        "release-owner": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "contract-owner": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "capture-owner": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "consumer-owner": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "web-control-owner": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "network-owner": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "security-owner": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "build-platform-owner": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "qa-evidence-owner": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "hardware-owner": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "pipeline-owner": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      }
    },
    "componentAcceptanceMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rp-ylx-target-session-reader",
        "rp-ylx-v1-projection-adapter",
        "spectacular-calibration-reader",
        "ylx-card-pipeline",
        "ylx-transfer",
        "egoview-console",
        "g3-egoview-v5-wrapper"
      ],
      "properties": {
        "rp-ylx-target-session-reader": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "rp-ylx-v1-projection-adapter": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "spectacular-calibration-reader": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "ylx-card-pipeline": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "ylx-transfer": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "egoview-console": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "g3-egoview-v5-wrapper": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
