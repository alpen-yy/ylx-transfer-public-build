{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/domain-attestation-v2.schema.json",
  "title": "YLX typed domain attestation v2",
  "description": "Revisioned domain attestation over the exact release-result projection v2, M5 binding context v2, and effective M4 lineage. It cannot be mixed with a v1 projection or context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attestation_id",
    "revision",
    "predecessor_attestation_ref",
    "created_at",
    "artifact_path",
    "artifact_metadata",
    "role_id",
    "attesting_identity",
    "role_assignment_ref",
    "subject_refs",
    "evidence_refs",
    "decision_refs",
    "current_issue_head",
    "binding_context_ref",
    "effective_m4_lineage_ref",
    "release_result_projection_ref",
    "release_result_projection_sha256",
    "projection_operation_assignment_ref",
    "shared_context_refs",
    "conflict_control_ref",
    "attestation_outcome",
    "attested_at"
  ],
  "properties": {
    "schema": {
      "const": "ylx.domain-attestation.v2"
    },
    "attestation_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor_attestation_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/domainAttestationRef"
        }
      ]
    },
    "created_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "artifact_path": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "artifact_metadata": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactMetadata"
    },
    "role_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/roleId"
    },
    "attesting_identity": {
      "$ref": "#/$defs/naturalPersonIdentity"
    },
    "role_assignment_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/authorityRef"
    },
    "subject_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
      }
    },
    "decision_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sourceRef"
      }
    },
    "current_issue_head": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/issueHead"
    },
    "binding_context_ref": {
      "$ref": "#/$defs/bindingContextRef"
    },
    "effective_m4_lineage_ref": {
      "$ref": "#/$defs/m4ContextLineageRef"
    },
    "release_result_projection_ref": {
      "$ref": "#/$defs/releaseResultProjectionRef"
    },
    "release_result_projection_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "projection_operation_assignment_ref": {
      "$ref": "#/$defs/releaseOperationAssignmentRef"
    },
    "shared_context_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
      }
    },
    "conflict_control_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        }
      ]
    },
    "consumer_bindings": {
      "$ref": "#/$defs/consumerBindings"
    },
    "attestation_outcome": {
      "enum": [
        "PASS",
        "BLOCKED"
      ]
    },
    "attested_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": [
          "revision"
        ]
      },
      "then": {
        "properties": {
          "predecessor_attestation_ref": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 2
          },
          "predecessor_attestation_ref": {
            "$ref": "#/$defs/domainAttestationRef"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role_id": {
            "const": "consumer-owner"
          }
        },
        "required": [
          "role_id"
        ]
      },
      "then": {
        "required": [
          "consumer_bindings"
        ]
      },
      "else": {
        "not": {
          "required": [
            "consumer_bindings"
          ]
        }
      }
    }
  ],
  "$defs": {
    "domainAttestationRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.domain-attestation.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "bindingContextRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.binding-context.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "m4ContextLineageRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.m4-context-lineage.v1"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "releaseResultProjectionRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.release-result-projection.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "releaseOperationAssignmentRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.release-operation-assignment.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "naturalPersonIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_id",
        "natural_person_identity_sha256",
        "identity_authority_ref"
      ],
      "properties": {
        "person_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "natural_person_identity_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "identity_authority_ref": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/authorityRef"
        }
      }
    },
    "consumerBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_boundary_registry_sha256",
        "consumer_boundary_acceptance_set_sha256",
        "component_acceptance_record_sha256_by_boundary"
      ],
      "properties": {
        "consumer_boundary_registry_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "consumer_boundary_acceptance_set_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "component_acceptance_record_sha256_by_boundary": {
          "$ref": "#/$defs/componentAcceptanceMap"
        }
      }
    },
    "componentAcceptanceMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rp-ylx-target-session-reader",
        "rp-ylx-v1-projection-adapter",
        "spectacular-calibration-reader",
        "ylx-card-pipeline",
        "ylx-transfer",
        "egoview-console",
        "g3-egoview-v5-wrapper"
      ],
      "properties": {
        "rp-ylx-target-session-reader": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "rp-ylx-v1-projection-adapter": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "spectacular-calibration-reader": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "ylx-card-pipeline": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "ylx-transfer": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "egoview-console": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "g3-egoview-v5-wrapper": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
