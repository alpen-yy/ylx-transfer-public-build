{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/release-result-projection-v1.schema.json",
  "title": "YLX release result projection v1",
  "description": "Immutable non-authoritative projection of the 171 current effective stage-native core results and their exact evidence and applicability inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projection_id",
    "revision",
    "predecessor_projection_sha256",
    "m5_binding_context_ref",
    "effective_m4_binding_context_ref",
    "registry_sha256",
    "registry_id_set_sha256",
    "core_requirement_id_set_sha256",
    "core_requirement_cardinality",
    "acceptance_sha256",
    "system_requirement_mapping_artifact_sha256",
    "system_requirement_mapping_semantic_sha256",
    "selected_gate_root_ref_by_closing_gate",
    "row_projection_by_requirement_id",
    "evidence_record_sha256_by_id",
    "issue_head",
    "issue_reconciliation_set_sha256",
    "projection_algorithm",
    "projection_version",
    "projector_person_id",
    "created_at",
    "artifact_metadata"
  ],
  "properties": {
    "schema": {
      "const": "ylx.release-result-projection.v1"
    },
    "projection_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor_projection_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      ]
    },
    "m5_binding_context_ref": {
      "$ref": "#/$defs/bindingContextRef"
    },
    "effective_m4_binding_context_ref": {
      "$ref": "#/$defs/bindingContextRef"
    },
    "registry_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "registry_id_set_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "core_requirement_id_set_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "core_requirement_cardinality": {
      "const": 171
    },
    "acceptance_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "system_requirement_mapping_artifact_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "system_requirement_mapping_semantic_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "selected_gate_root_ref_by_closing_gate": {
      "$ref": "#/$defs/selectedGateRootMap"
    },
    "row_projection_by_requirement_id": {
      "$ref": "#/$defs/rowProjectionMap"
    },
    "evidence_record_sha256_by_id": {
      "$ref": "#/$defs/evidenceDigestMap"
    },
    "issue_head": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/issueHead"
    },
    "issue_reconciliation_set_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "projection_algorithm": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "projection_version": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "projector_person_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "created_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "artifact_metadata": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactMetadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": [
          "revision"
        ]
      },
      "then": {
        "properties": {
          "predecessor_projection_sha256": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "predecessor_projection_sha256": {
            "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
          }
        }
      }
    }
  ],
  "not": {
    "anyOf": [
      { "required": ["release_result_projection_sha256"] },
      { "required": ["artifact_path"] },
      { "required": ["artifact_locator"] },
      { "required": ["domain_attestation_sha256_by_role_slot"] },
      { "required": ["pre_release_closure_ref"] },
      { "required": ["pre_release_closure_sha256"] },
      { "required": ["quorum_signature_sha256_by_role_slot"] },
      { "required": ["publication_fence_ref"] },
      { "required": ["publication_fence_sha256"] },
      { "required": ["ga_promotion_receipt_ref"] },
      { "required": ["ga_promotion_receipt_sha256"] },
      { "required": ["final_manifest_ref"] },
      { "required": ["final_manifest_sha256"] },
      { "required": ["final_result_map"] },
      { "required": ["release_decision"] },
      { "required": ["release_completion"] }
    ]
  },
  "$defs": {
    "exactArtifactRef": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
    },
    "bindingContextRef": {
      "allOf": [
        {
          "$ref": "#/$defs/exactArtifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.binding-context.v1"
            }
          },
          "required": [
            "schema"
          ]
        }
      ]
    },
    "evidenceBindingRef": {
      "allOf": [
        {
          "$ref": "#/$defs/exactArtifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.evidence-binding.v1"
            }
          },
          "required": [
            "schema"
          ]
        }
      ]
    },
    "nullableArtifactRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/exactArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "selectedGateRootMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "M0",
        "M1",
        "M2",
        "M3",
        "M4a",
        "M4b",
        "M4c",
        "M4d",
        "M4",
        "M5"
      ],
      "properties": {
        "M0": { "$ref": "#/$defs/exactArtifactRef" },
        "M1": { "$ref": "#/$defs/exactArtifactRef" },
        "M2": { "$ref": "#/$defs/exactArtifactRef" },
        "M3": { "$ref": "#/$defs/exactArtifactRef" },
        "M4a": { "$ref": "#/$defs/exactArtifactRef" },
        "M4b": { "$ref": "#/$defs/exactArtifactRef" },
        "M4c": { "$ref": "#/$defs/exactArtifactRef" },
        "M4d": { "$ref": "#/$defs/exactArtifactRef" },
        "M4": { "$ref": "#/$defs/exactArtifactRef" },
        "M5": { "$ref": "#/$defs/exactArtifactRef" }
      }
    },
    "rowProjectionMap": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 171,
      "maxProperties": 171,
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^[A-Z0-9][A-Z0-9-]+$"
          },
          {
            "not": {
              "enum": [
                "M5-MATRIX-COMPLETE-01",
                "M5-SIGNOFF-01"
              ]
            }
          }
        ]
      },
      "patternProperties": {
        "^[A-Z0-9][A-Z0-9-]+$": {
          "$ref": "#/$defs/rowProjection"
        }
      }
    },
    "rowProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closing_gate",
        "effective_result",
        "effective_result_ref",
        "source_scope_ref",
        "evidence_binding_refs",
        "evidence_ids",
        "approved_na_record_ref"
      ],
      "properties": {
        "closing_gate": {
          "enum": [
            "M0",
            "M1",
            "M2",
            "M3",
            "M4a",
            "M4b",
            "M4c",
            "M4d",
            "M4",
            "M5"
          ]
        },
        "effective_result": {
          "enum": [
            "PASS",
            "N/A"
          ]
        },
        "effective_result_ref": {
          "$ref": "#/$defs/exactArtifactRef"
        },
        "source_scope_ref": {
          "$ref": "#/$defs/exactArtifactRef"
        },
        "evidence_binding_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceBindingRef"
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
          },
          "uniqueItems": true
        },
        "approved_na_record_ref": {
          "$ref": "#/$defs/nullableArtifactRef"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effective_result": {
                "const": "PASS"
              }
            },
            "required": [
              "effective_result"
            ]
          },
          "then": {
            "properties": {
              "approved_na_record_ref": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "approved_na_record_ref": {
                "$ref": "#/$defs/exactArtifactRef"
              }
            }
          }
        }
      ]
    },
    "evidenceDigestMap": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
