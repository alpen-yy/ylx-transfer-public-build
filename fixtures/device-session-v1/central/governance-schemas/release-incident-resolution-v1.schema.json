{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/release-incident-resolution-v1.schema.json",
  "title": "YLX release incident resolution v1",
  "description": "Immutable evidence that one exact release incident revision has been resolved against the same finalized release, channel scope, and current predecessor distribution control. Resolution alone never reactivates distribution; a separate current reactivation-evidence artifact and signed successor control are required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "resolution_id",
    "incident_id",
    "incident_root_id",
    "revision",
    "predecessor_resolution_ref",
    "incident_ref",
    "finalized_release_binding",
    "channel_binding",
    "predecessor_control_ref",
    "resolution_assignment_ref",
    "status",
    "resolved_at",
    "root_cause_sha256",
    "root_cause_summary",
    "corrective_actions",
    "verification_evidence_refs",
    "residual_risk",
    "distribution_reactivation_authority",
    "artifact_metadata"
  ],
  "properties": {
    "schema": {
      "const": "ylx.release-incident-resolution.v1"
    },
    "resolution_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "incident_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "incident_root_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor_resolution_ref": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/incidentResolutionRef" }
      ]
    },
    "incident_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/release-incident-v1.schema.json#/$defs/releaseIncidentRef"
    },
    "finalized_release_binding": {
      "$ref": "https://schemas.ylx.invalid/governance/release-operation-assignment-v2.schema.json#/$defs/finalizedReleaseBinding"
    },
    "channel_binding": {
      "$ref": "https://schemas.ylx.invalid/governance/release-operation-assignment-v2.schema.json#/$defs/channelBinding"
    },
    "predecessor_control_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/release-operation-assignment-v2.schema.json#/$defs/distributionControlRef"
    },
    "resolution_assignment_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/release-operation-assignment-v2.schema.json#/$defs/releaseOperationAssignmentRef",
      "description": "The exact v2 assignment must authorize RESOLVE_INCIDENT and bind this incident, finalized release, channel, and predecessor control procedurally."
    },
    "status": {
      "const": "RESOLVED"
    },
    "resolved_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "root_cause_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "root_cause_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "corrective_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/correctiveAction"
      }
    },
    "verification_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
      }
    },
    "residual_risk": {
      "enum": ["NONE_IDENTIFIED", "ACCEPTED_WITH_CONTROLS"]
    },
    "distribution_reactivation_authority": {
      "const": "REQUIRES_SEPARATE_CURRENT_REACTIVATION_EVIDENCE_AND_SIGNED_SUCCESSOR"
    },
    "artifact_metadata": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactMetadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "revision": { "const": 1 } },
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "predecessor_resolution_ref": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "revision": { "type": "integer", "minimum": 2 },
          "predecessor_resolution_ref": { "$ref": "#/$defs/incidentResolutionRef" }
        }
      }
    }
  ],
  "$defs": {
    "incidentResolutionRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "required": ["revision"],
          "properties": {
            "schema": { "const": "ylx.release-incident-resolution.v1" }
          }
        }
      ]
    },
    "correctiveAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "description", "status", "evidence_refs"],
      "properties": {
        "action_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "status": { "const": "COMPLETED" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
          }
        }
      }
    }
  }
}
