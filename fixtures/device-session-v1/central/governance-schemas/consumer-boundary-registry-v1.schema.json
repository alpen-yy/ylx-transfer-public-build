{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/consumer-boundary-registry-v1.schema.json",
  "title": "YLX consumer boundary registry v1",
  "description": "The closed M1 authority for the seven consumer boundaries in the current product-contract scope. Exact-byte identity is carried by consumer_boundary_registry_sha256 in referring artifacts, never by this document itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "predecessor_registry_sha256",
    "decision_set_id",
    "product_contract_sha256",
    "boundaries",
    "scope_change",
    "approvals"
  ],
  "properties": {
    "schema": {
      "const": "ylx.consumer-boundary-registry.v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor_registry_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      ]
    },
    "decision_set_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "product_contract_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "boundaries": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/boundary"
      },
      "allOf": [
        {
          "$ref": "#/$defs/containsRpYlxTargetSessionReader"
        },
        {
          "$ref": "#/$defs/containsRpYlxV1ProjectionAdapter"
        },
        {
          "$ref": "#/$defs/containsSpectacularCalibrationReader"
        },
        {
          "$ref": "#/$defs/containsYlxCardPipeline"
        },
        {
          "$ref": "#/$defs/containsYlxTransfer"
        },
        {
          "$ref": "#/$defs/containsEgoviewConsole"
        },
        {
          "$ref": "#/$defs/containsG3EgoviewV5Wrapper"
        }
      ]
    },
    "scope_change": {
      "$ref": "#/$defs/scopeChange"
    },
    "approvals": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "allOf": [
          {
            "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/approval"
          },
          {
            "properties": {
              "decision": {
                "enum": [
                  "APPROVED",
                  "SYNTHETIC_ONLY"
                ]
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "role_id": {
                "const": "release-owner"
              },
              "decision": {
                "enum": [
                  "APPROVED",
                  "SYNTHETIC_ONLY"
                ]
              }
            },
            "required": [
              "role_id",
              "decision"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role_id": {
                "const": "contract-owner"
              },
              "decision": {
                "enum": [
                  "APPROVED",
                  "SYNTHETIC_ONLY"
                ]
              }
            },
            "required": [
              "role_id",
              "decision"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role_id": {
                "const": "consumer-owner"
              },
              "decision": {
                "enum": [
                  "APPROVED",
                  "SYNTHETIC_ONLY"
                ]
              }
            },
            "required": [
              "role_id",
              "decision"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": [
          "revision"
        ]
      },
      "then": {
        "properties": {
          "predecessor_registry_sha256": {
            "type": "null"
          },
          "scope_change": {
            "$ref": "#/$defs/initialScopeChange"
          }
        }
      },
      "else": {
        "properties": {
          "predecessor_registry_sha256": {
            "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
          },
          "scope_change": {
            "oneOf": [
              {
                "$ref": "#/$defs/noScopeChange"
              },
              {
                "$ref": "#/$defs/materialScopeChange"
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "boundaryId": {
      "enum": [
        "rp-ylx-target-session-reader",
        "rp-ylx-v1-projection-adapter",
        "spectacular-calibration-reader",
        "ylx-card-pipeline",
        "ylx-transfer",
        "egoview-console",
        "g3-egoview-v5-wrapper"
      ]
    },
    "boundaryIdSet": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/boundaryId"
      }
    },
    "boundaryDigestMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rp-ylx-target-session-reader",
        "rp-ylx-v1-projection-adapter",
        "spectacular-calibration-reader",
        "ylx-card-pipeline",
        "ylx-transfer",
        "egoview-console",
        "g3-egoview-v5-wrapper"
      ],
      "properties": {
        "rp-ylx-target-session-reader": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "rp-ylx-v1-projection-adapter": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "spectacular-calibration-reader": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "ylx-card-pipeline": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "ylx-transfer": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "egoview-console": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "g3-egoview-v5-wrapper": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      }
    },
    "contractIdSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
      }
    },
    "scopeBoundaryIdSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
      }
    },
    "scopeChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_kind",
        "reason",
        "added_boundary_ids",
        "retired_boundary_ids",
        "replacement_or_retirement_evidence_refs"
      ],
      "properties": {
        "change_kind": {
          "enum": [
            "INITIAL",
            "NO_SCOPE_CHANGE",
            "SCOPE_CHANGE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "added_boundary_ids": {
          "$ref": "#/$defs/scopeBoundaryIdSet"
        },
        "retired_boundary_ids": {
          "$ref": "#/$defs/scopeBoundaryIdSet"
        },
        "replacement_or_retirement_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
          }
        }
      }
    },
    "initialScopeChange": {
      "allOf": [
        {
          "$ref": "#/$defs/scopeChange"
        },
        {
          "properties": {
            "change_kind": {
              "const": "INITIAL"
            },
            "added_boundary_ids": {
              "maxItems": 0
            },
            "retired_boundary_ids": {
              "maxItems": 0
            },
            "replacement_or_retirement_evidence_refs": {
              "maxItems": 0
            }
          }
        }
      ]
    },
    "noScopeChange": {
      "allOf": [
        {
          "$ref": "#/$defs/scopeChange"
        },
        {
          "properties": {
            "change_kind": {
              "const": "NO_SCOPE_CHANGE"
            },
            "added_boundary_ids": {
              "maxItems": 0
            },
            "retired_boundary_ids": {
              "maxItems": 0
            },
            "replacement_or_retirement_evidence_refs": {
              "maxItems": 0
            }
          }
        }
      ]
    },
    "materialScopeChange": {
      "allOf": [
        {
          "$ref": "#/$defs/scopeChange"
        },
        {
          "properties": {
            "change_kind": {
              "const": "SCOPE_CHANGE"
            },
            "replacement_or_retirement_evidence_refs": {
              "minItems": 1
            }
          },
          "anyOf": [
            {
              "properties": {
                "added_boundary_ids": {
                  "minItems": 1
                }
              }
            },
            {
              "properties": {
                "retired_boundary_ids": {
                  "minItems": 1
                }
              }
            }
          ]
        }
      ]
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_id",
        "applicability",
        "component_artifact_owner",
        "component_maintainer_subrole",
        "legacy_input_contracts",
        "target_input_contracts"
      ],
      "properties": {
        "boundary_id": {
          "$ref": "#/$defs/boundaryId"
        },
        "applicability": {
          "const": "applicable"
        },
        "component_artifact_owner": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "component_maintainer_subrole": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "legacy_input_contracts": {
          "$ref": "#/$defs/contractIdSet"
        },
        "target_input_contracts": {
          "$ref": "#/$defs/contractIdSet"
        }
      }
    },
    "containsRpYlxTargetSessionReader": {
      "contains": {
        "properties": {
          "boundary_id": {
            "const": "rp-ylx-target-session-reader"
          }
        },
        "required": [
          "boundary_id"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "containsRpYlxV1ProjectionAdapter": {
      "contains": {
        "properties": {
          "boundary_id": {
            "const": "rp-ylx-v1-projection-adapter"
          }
        },
        "required": [
          "boundary_id"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "containsSpectacularCalibrationReader": {
      "contains": {
        "properties": {
          "boundary_id": {
            "const": "spectacular-calibration-reader"
          }
        },
        "required": [
          "boundary_id"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "containsYlxCardPipeline": {
      "contains": {
        "properties": {
          "boundary_id": {
            "const": "ylx-card-pipeline"
          }
        },
        "required": [
          "boundary_id"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "containsYlxTransfer": {
      "contains": {
        "properties": {
          "boundary_id": {
            "const": "ylx-transfer"
          }
        },
        "required": [
          "boundary_id"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "containsEgoviewConsole": {
      "contains": {
        "properties": {
          "boundary_id": {
            "const": "egoview-console"
          }
        },
        "required": [
          "boundary_id"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "containsG3EgoviewV5Wrapper": {
      "contains": {
        "properties": {
          "boundary_id": {
            "const": "g3-egoview-v5-wrapper"
          }
        },
        "required": [
          "boundary_id"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    }
  }
}
