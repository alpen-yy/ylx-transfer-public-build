{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/domain-attestation-v1.schema.json",
  "title": "YLX typed domain attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attestation_id",
    "revision",
    "predecessor_sha256",
    "created_at",
    "artifact_path",
    "artifact_metadata",
    "role_id",
    "attesting_identity",
    "role_assignment_ref",
    "subject_refs",
    "evidence_refs",
    "decision_refs",
    "current_issue_head",
    "binding_context_ref",
    "shared_context_refs",
    "conflict_control_ref",
    "attestation_outcome",
    "attested_at"
  ],
  "properties": {
    "schema": {
      "const": "ylx.domain-attestation.v1"
    },
    "attestation_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      ]
    },
    "created_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "artifact_path": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "artifact_metadata": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactMetadata"
    },
    "role_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/roleId"
    },
    "attesting_identity": {
      "$ref": "#/$defs/naturalPersonIdentity"
    },
    "role_assignment_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/authorityRef"
    },
    "subject_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
      },
      "uniqueItems": true
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sourceRef"
      },
      "uniqueItems": true
    },
    "current_issue_head": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/issueHead"
    },
    "binding_context_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
    },
    "shared_context_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
      },
      "uniqueItems": true
    },
    "conflict_control_ref": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef" }
      ]
    },
    "consumer_bindings": {
      "$ref": "#/$defs/consumerBindings"
    },
    "attestation_outcome": {
      "enum": [
        "PASS",
        "BLOCKED"
      ]
    },
    "attested_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "role_id": { "const": "consumer-owner" } },
        "required": ["role_id"]
      },
      "then": {
        "required": ["consumer_bindings"]
      },
      "else": {
        "not": { "required": ["consumer_bindings"] }
      }
    }
  ],
  "$defs": {
    "naturalPersonIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_id",
        "natural_person_identity_sha256",
        "identity_authority_ref"
      ],
      "properties": {
        "person_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "natural_person_identity_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "identity_authority_ref": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/authorityRef"
        }
      }
    },
    "consumerBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_boundary_registry_sha256",
        "consumer_boundary_acceptance_set_sha256",
        "component_acceptance_record_sha256_by_boundary"
      ],
      "properties": {
        "consumer_boundary_registry_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "consumer_boundary_acceptance_set_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "component_acceptance_record_sha256_by_boundary": {
          "$ref": "https://schemas.ylx.invalid/governance/pre-release-closure-v1.schema.json#/$defs/componentAcceptanceMap"
        }
      }
    }
  }
}
