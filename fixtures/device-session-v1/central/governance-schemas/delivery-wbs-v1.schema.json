{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/delivery-wbs-v1.schema.json",
  "title": "YLX delivery WBS v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_id",
    "revision",
    "predecessor_sha256",
    "generated_at",
    "source_refs",
    "approvals",
    "artifact_metadata",
    "overall_status",
    "planning_gate",
    "scope_revision",
    "requirement_ids",
    "active_blocker_ids",
    "tasks",
    "blockers"
  ],
  "properties": {
    "schema": {
      "const": "ylx.delivery-wbs.v1"
    },
    "artifact_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor_sha256": {
      "anyOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sourceRef"
      },
      "uniqueItems": true
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/approval"
      },
      "uniqueItems": true
    },
    "artifact_metadata": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactMetadata"
    },
    "overall_status": {
      "enum": [
        "ACCEPTED",
        "INPUT_BLOCKED"
      ]
    },
    "planning_gate": {
      "enum": [
        "M0",
        "M1",
        "M2",
        "M3",
        "M4",
        "M5"
      ]
    },
    "scope_revision": {
      "type": "integer",
      "minimum": 1
    },
    "requirement_ids": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stringSet"
    },
    "active_blocker_ids": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stringSet"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/blocker"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "nullableIdentifier": {
      "anyOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableBlocker": {
      "anyOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/blocker"
        },
        {
          "type": "null"
        }
      ]
    },
    "confidenceInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper",
        "confidence"
      ],
      "properties": {
        "lower": {
          "type": "number",
          "minimum": 0
        },
        "upper": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimate_status",
        "value",
        "unit",
        "basis",
        "confidence_interval",
        "blocker"
      ],
      "properties": {
        "estimate_status": {
          "enum": [
            "ESTIMATED",
            "RANGE",
            "UNKNOWN"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000
        },
        "confidence_interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/confidenceInterval"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocker": {
          "$ref": "#/$defs/nullableBlocker"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "estimate_status": {
                "const": "ESTIMATED"
              }
            },
            "required": [
              "estimate_status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
              },
              "basis": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "confidence_interval": {
                "$ref": "#/$defs/confidenceInterval"
              },
              "blocker": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "estimate_status": {
                "const": "RANGE"
              }
            },
            "required": [
              "estimate_status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "unit": {
                "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
              },
              "basis": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "confidence_interval": {
                "$ref": "#/$defs/confidenceInterval"
              },
              "blocker": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "estimate_status": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "estimate_status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "unit": {
                "type": "null"
              },
              "basis": {
                "type": "null"
              },
              "confidence_interval": {
                "type": "null"
              },
              "blocker": {
                "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/blocker"
              }
            }
          }
        }
      ]
    },
    "lag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        }
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor_status",
        "predecessor_task_id",
        "relation_type",
        "lag",
        "blocker"
      ],
      "properties": {
        "predecessor_status": {
          "enum": [
            "RESOLVED",
            "UNKNOWN"
          ]
        },
        "predecessor_task_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "relation_type": {
          "anyOf": [
            {
              "enum": [
                "FINISH_TO_START",
                "START_TO_START",
                "FINISH_TO_FINISH",
                "START_TO_FINISH"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "lag": {
          "anyOf": [
            {
              "$ref": "#/$defs/lag"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocker": {
          "$ref": "#/$defs/nullableBlocker"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "predecessor_status": {
                "const": "RESOLVED"
              }
            },
            "required": [
              "predecessor_status"
            ]
          },
          "then": {
            "properties": {
              "predecessor_task_id": {
                "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
              },
              "relation_type": {
                "enum": [
                  "FINISH_TO_START",
                  "START_TO_START",
                  "FINISH_TO_FINISH",
                  "START_TO_FINISH"
                ]
              },
              "lag": {
                "$ref": "#/$defs/lag"
              },
              "blocker": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "predecessor_task_id": {
                "type": "null"
              },
              "relation_type": {
                "type": "null"
              },
              "lag": {
                "type": "null"
              },
              "blocker": {
                "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/blocker"
              }
            }
          }
        }
      ]
    },
    "resourceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "requirement_status",
        "resource_kind",
        "resource_id",
        "quantity",
        "capacity_unit",
        "window_ids",
        "blocker"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "requirement_status": {
          "enum": [
            "RESOLVED",
            "UNKNOWN"
          ]
        },
        "resource_kind": {
          "enum": [
            "CAPACITY",
            "TARGET_HARDWARE",
            "CAMERA",
            "MEDIA",
            "CREDENTIAL",
            "REMOTE",
            "CI_RUNNER",
            "PRODUCTION_ACCESS"
          ]
        },
        "resource_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "quantity": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "capacity_unit": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "window_ids": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stringSet"
        },
        "blocker": {
          "$ref": "#/$defs/nullableBlocker"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "requirement_status": {
                "const": "RESOLVED"
              }
            },
            "required": [
              "requirement_status"
            ]
          },
          "then": {
            "properties": {
              "resource_id": {
                "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
              },
              "quantity": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "capacity_unit": {
                "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
              },
              "blocker": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "resource_id": {
                "type": "null"
              },
              "quantity": {
                "type": "null"
              },
              "capacity_unit": {
                "type": "null"
              },
              "window_ids": {
                "maxItems": 0
              },
              "blocker": {
                "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/blocker"
              }
            }
          }
        }
      ]
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_id",
        "severity",
        "description",
        "mitigation"
      ],
      "properties": {
        "risk_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "severity": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "mitigation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    },
    "conditionalBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_id",
        "selection_predicate",
        "in_scope",
        "accountable_party_id",
        "effort_range",
        "fixed_duration_range"
      ],
      "properties": {
        "branch_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "selection_predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "in_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "uniqueItems": true
        },
        "accountable_party_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "effort_range": {
          "allOf": [
            {
              "$ref": "#/$defs/estimate"
            },
            {
              "properties": {
                "estimate_status": {
                  "const": "RANGE"
                }
              }
            }
          ]
        },
        "fixed_duration_range": {
          "allOf": [
            {
              "$ref": "#/$defs/estimate"
            },
            {
              "properties": {
                "estimate_status": {
                  "const": "RANGE"
                }
              }
            }
          ]
        }
      }
    },
    "conditionalScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_task_id",
        "selection_status",
        "selected_branch_id",
        "branches"
      ],
      "properties": {
        "decision_task_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "selection_status": {
          "enum": [
            "PENDING",
            "SELECTED"
          ]
        },
        "selected_branch_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "branches": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/conditionalBranch"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selection_status": {
                "const": "PENDING"
              }
            },
            "required": [
              "selection_status"
            ]
          },
          "then": {
            "properties": {
              "selected_branch_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "selected_branch_id": {
                "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
              }
            }
          }
        }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "parent_task_id",
        "task_kind",
        "deliverable",
        "in_scope",
        "out_of_scope",
        "milestone_id",
        "gate_id",
        "authorization_class",
        "planning_detail",
        "conditional_scenario",
        "authorization_refs",
        "authorization_stop_rules",
        "affected_requirement_ids",
        "affected_issue_ids",
        "accountable_party_id",
        "executor_id",
        "reviewer_id",
        "effort_estimate",
        "fixed_duration_estimate",
        "predecessors",
        "resource_requirements",
        "definition_of_done",
        "evidence_locator",
        "planning_status",
        "status",
        "risks",
        "blockers"
      ],
      "properties": {
        "task_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "parent_task_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "task_kind": {
          "enum": [
            "SUMMARY",
            "LEAF"
          ]
        },
        "deliverable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "uniqueItems": true
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "uniqueItems": true
        },
        "milestone_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "gate_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "authorization_class": {
          "enum": [
            "may_prepare",
            "may_implement",
            "may_qualify",
            "may_deploy",
            "may_enable_writer"
          ]
        },
        "planning_detail": {
          "enum": [
            "DETAILED_EXECUTABLE",
            "CONDITIONAL_SCENARIO"
          ]
        },
        "conditional_scenario": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/conditionalScenario"
            }
          ]
        },
        "authorization_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
          },
          "uniqueItems": true
        },
        "authorization_stop_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "uniqueItems": true
        },
        "affected_requirement_ids": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stringSet"
        },
        "affected_issue_ids": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stringSet"
        },
        "accountable_party_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "executor_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "reviewer_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "effort_estimate": {
          "$ref": "#/$defs/estimate"
        },
        "fixed_duration_estimate": {
          "$ref": "#/$defs/estimate"
        },
        "predecessors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predecessor"
          },
          "uniqueItems": true
        },
        "resource_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceRequirement"
          },
          "uniqueItems": true
        },
        "definition_of_done": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uniqueItems": true
        },
        "evidence_locator": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
        },
        "planning_status": {
          "enum": [
            "READY",
            "CONDITIONAL_READY",
            "INPUT_BLOCKED"
          ]
        },
        "status": {
          "enum": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "BLOCKED",
            "COMPLETE"
          ]
        },
        "risks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/risk"
          },
          "uniqueItems": true
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/blocker"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "planning_status": {
                "const": "READY"
              }
            },
            "required": [
              "planning_status"
            ]
          },
          "then": {
            "properties": {
              "accountable_party_id": {
                "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
              },
              "executor_id": {
                "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
              },
              "reviewer_id": {
                "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
              },
              "effort_estimate": {
                "properties": {
                  "estimate_status": {
                    "const": "ESTIMATED"
                  }
                }
              },
              "fixed_duration_estimate": {
                "properties": {
                  "estimate_status": {
                    "const": "ESTIMATED"
                  }
                }
              },
              "predecessors": {
                "items": {
                  "properties": {
                    "predecessor_status": {
                      "const": "RESOLVED"
                    }
                  }
                }
              },
              "resource_requirements": {
                "items": {
                  "properties": {
                    "requirement_status": {
                      "const": "RESOLVED"
                    }
                  }
                }
              },
              "blockers": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "planning_status": {
                "const": "CONDITIONAL_READY"
              }
            },
            "required": [
              "planning_status"
            ]
          },
          "then": {
            "properties": {
              "task_kind": {
                "const": "SUMMARY"
              },
              "gate_id": {
                "enum": [
                  "M2",
                  "M3",
                  "M4",
                  "M5"
                ]
              },
              "planning_detail": {
                "const": "CONDITIONAL_SCENARIO"
              },
              "conditional_scenario": {
                "$ref": "#/$defs/conditionalScenario"
              },
              "accountable_party_id": {
                "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
              },
              "executor_id": {
                "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
              },
              "reviewer_id": {
                "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
              },
              "effort_estimate": {
                "properties": {
                  "estimate_status": {
                    "const": "RANGE"
                  }
                }
              },
              "fixed_duration_estimate": {
                "properties": {
                  "estimate_status": {
                    "const": "RANGE"
                  }
                }
              },
              "blockers": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "planning_status": {
                "const": "INPUT_BLOCKED"
              }
            },
            "required": [
              "planning_status"
            ]
          },
          "then": {
            "properties": {
              "blockers": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "planning_detail": {
                "const": "DETAILED_EXECUTABLE"
              }
            },
            "required": [
              "planning_detail"
            ]
          },
          "then": {
            "properties": {
              "conditional_scenario": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "conditional_scenario": {
                "$ref": "#/$defs/conditionalScenario"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_kind": {
                "const": "LEAF"
              }
            },
            "required": [
              "task_kind"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "affected_requirement_ids": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "affected_issue_ids": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": [
          "revision"
        ]
      },
      "then": {
        "properties": {
          "predecessor_sha256": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "predecessor_sha256": {
            "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "ACCEPTED"
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "properties": {
          "approvals": {
            "minItems": 1
          },
          "tasks": {
            "items": {
              "properties": {
                "planning_status": {
                  "enum": [
                    "READY",
                    "CONDITIONAL_READY"
                  ]
                }
              }
            }
          },
          "blockers": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "blockers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tasks": {
            "contains": {
              "properties": {
                "planning_status": {
                  "const": "INPUT_BLOCKED"
                }
              },
              "required": [
                "planning_status"
              ]
            }
          }
        },
        "required": [
          "tasks"
        ]
      },
      "then": {
        "properties": {
          "overall_status": {
            "const": "INPUT_BLOCKED"
          }
        }
      }
    }
  ]
}
