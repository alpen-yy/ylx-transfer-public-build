{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/planning-bootstrap-publication-receipt-v1.schema.json",
  "title": "YLX planning bootstrap root publication receipt P v1",
  "description": "Signed terminal external audit-sink receipt for one independently authorized create-if-absent publication of an intrinsically valid M0-B revision-1 planning root F or its containing-bundle approval subject S. P exact-binds the artifact identity and bytes, real actor, pre-existing write-operation authority, separate per-write repository permission, repository target, create result, and durable file-and-parent-directory fsync. P is an append-only sink output rather than a repository write and grants no planning, approval, execution, evidence, verdict, release, or recovery authority. The signature message is UTF8(\"YLX-PLANNING-BOOTSTRAP-TERMINAL-RECEIPT-V1\") || 0x00 || RFC8785(receipt fields excluding signed_payload_sha256 and signature); procedural validation recomputes signed_payload_sha256 and verifies the Ed25519 signature under the terminal sink's current trusted key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "artifact_schema",
    "artifact_id",
    "revision",
    "actor_id",
    "write_operation_authority_ref",
    "write_operation_authority_sha256",
    "repository_permission_ref",
    "repository_permission_sha256",
    "repository_locator",
    "operation",
    "target_scope",
    "artifact_ref",
    "artifact_sha256",
    "byte_length",
    "published_at",
    "create_result",
    "fsync_result",
    "terminal_sink_id",
    "receipt_issuer_id",
    "signature_algorithm",
    "signing_key_id",
    "signed_payload_sha256",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "ylx.planning-bootstrap-publication-receipt.v1"
    },
    "receipt_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "artifact_schema": {
      "enum": [
        "ylx.owner-assignment.v1",
        "ylx.resource-calendar.v1",
        "ylx.delivery-wbs.v2",
        "ylx.forecast-snapshot.v1",
        "ylx.delivery-planning-bundle.v2",
        "ylx.planning-approval-subject.v1"
      ]
    },
    "artifact_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "revision": {
      "const": 1
    },
    "actor_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "write_operation_authority_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "write_operation_authority_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "repository_permission_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "repository_permission_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "repository_locator": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "operation": {
      "const": "CREATE_IF_ABSENT"
    },
    "target_scope": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "artifact_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "artifact_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "byte_length": {
      "type": "integer",
      "minimum": 2
    },
    "published_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "create_result": {
      "enum": [
        "CREATED_EXACT",
        "ALREADY_EXACT"
      ]
    },
    "fsync_result": {
      "const": "FILE_AND_PARENT_DIRECTORY_DURABLE"
    },
    "terminal_sink_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "receipt_issuer_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "signature_algorithm": {
      "const": "Ed25519"
    },
    "signing_key_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "signed_payload_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "signature": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$"
    }
  }
}
