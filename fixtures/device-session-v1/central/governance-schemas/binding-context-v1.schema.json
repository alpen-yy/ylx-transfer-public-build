{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/binding-context-v1.schema.json",
  "title": "YLX binding context v1",
  "description": "Immutable, content-addressed stage binding shared by evidence and verdict artifacts. The exact-byte SHA-256 is carried by the referring locator or index, never by this document. Governance owner/reviewer roles describe this context artifact only and are not evidence-run actors or reviewers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "context_id",
    "stage",
    "created_at",
    "owner_role",
    "reviewer_role",
    "lineage",
    "body",
    "artifact_metadata"
  ],
  "properties": {
    "schema": {
      "const": "ylx.binding-context.v1"
    },
    "context_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "stage": {
      "enum": [
        "M2",
        "M3",
        "M4",
        "M5"
      ]
    },
    "created_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "owner_role": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/roleId",
      "description": "Role accountable for the immutable context artifact, not the actor that produced evidence."
    },
    "reviewer_role": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/roleId",
      "description": "Role reviewing the context artifact, not the reviewer of a referenced evidence run."
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "body": {},
    "artifact_metadata": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactMetadata"
    }
  },
  "oneOf": [
    {
      "required": [
        "stage",
        "body"
      ],
      "properties": {
        "stage": {
          "const": "M2"
        },
        "body": {
          "$ref": "#/$defs/m2Body"
        }
      }
    },
    {
      "required": [
        "stage",
        "body"
      ],
      "properties": {
        "stage": {
          "const": "M3"
        },
        "body": {
          "$ref": "#/$defs/m3Body"
        }
      }
    },
    {
      "required": [
        "stage",
        "body"
      ],
      "properties": {
        "stage": {
          "const": "M4"
        },
        "body": {
          "$ref": "#/$defs/m4Body"
        }
      }
    },
    {
      "required": [
        "stage",
        "body"
      ],
      "properties": {
        "stage": {
          "const": "M5"
        },
        "body": {
          "$ref": "#/$defs/m5Body"
        }
      }
    }
  ],
  "$defs": {
    "lineageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_sha256"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
        },
        "artifact_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_refs",
        "decision_refs"
      ],
      "properties": {
        "baseline_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lineageRef"
          }
        },
        "decision_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lineageRef"
          }
        }
      }
    },
    "m2Body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_release_id",
        "contract_release_sha256",
        "product_contract_sha256",
        "qualification_governance_contract_sha256",
        "fixture_corpus_sha256",
        "consumer_deployment_set_sha256",
        "deployment_state"
      ],
      "properties": {
        "contract_release_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "contract_release_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256",
          "description": "Digest of the complete M2 contract release root binding both product and governance contract packages."
        },
        "product_contract_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256",
          "description": "Only this contract digest participates in product candidate identity."
        },
        "qualification_governance_contract_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "fixture_corpus_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "consumer_deployment_set_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256",
          "description": "Digest of the immutable observed consumer deployment set whose members bind actual deployment-record digests; contract freeze alone cannot populate this field."
        },
        "deployment_state": {
          "const": "target-disabled",
          "description": "M2 consumers may be deployed for dual read, but the target producer remains disabled."
        }
      }
    },
    "m3Body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "base_bundle_sha256",
        "rendered_core_config_sha256",
        "contract_release_sha256",
        "product_contract_sha256",
        "qualification_governance_contract_sha256",
        "qualification_revision",
        "qualification_plan_sha256"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "base_bundle_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "rendered_core_config_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "contract_release_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "product_contract_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "qualification_governance_contract_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "qualification_revision": {
          "type": "integer",
          "minimum": 1
        },
        "qualification_plan_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      }
    },
    "m4Body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "predecessor_candidate_id",
        "product_assembly_sha256",
        "m3_binding_context_sha256",
        "base_core_input_projection_sha256",
        "qualification_bundle_sha256",
        "rendered_config_sha256",
        "contract_release_sha256",
        "product_contract_sha256",
        "qualification_governance_contract_sha256",
        "qualification_revision",
        "qualification_plan_sha256",
        "qualification_input_sha256_by_id",
        "component_impact_graph_sha256"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "predecessor_candidate_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "product_assembly_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "m3_binding_context_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "base_core_input_projection_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "qualification_bundle_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "rendered_config_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "contract_release_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "product_contract_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "qualification_governance_contract_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "qualification_revision": {
          "type": "integer",
          "minimum": 1
        },
        "qualification_plan_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "qualification_input_sha256_by_id": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,159}$": {
              "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
            }
          },
          "description": "Closed exact map of every qualification-only input whose drift must change the M4 binding-context identity without changing the shipped product candidate."
        },
        "component_impact_graph_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256",
          "description": "Independent digest of the versioned M4 impact graph; it is not part of the candidate-neutral component bundles or product assembly bytes."
        }
      }
    },
    "m5Body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "release_bundle_sha256",
        "production_binding_sha256",
        "contract_release_sha256",
        "product_contract_sha256",
        "qualification_governance_contract_sha256",
        "effective_m4_binding_context_sha256"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "release_bundle_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "production_binding_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "contract_release_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "product_contract_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "qualification_governance_contract_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "effective_m4_binding_context_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256",
          "description": "Exact-byte digest of the effective M4 binding context whose qualified bytes and qualification lineage are promoted into M5."
        }
      }
    }
  }
}
