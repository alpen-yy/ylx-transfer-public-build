{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/g0-policy-ratification-readback-receipt-v1.schema.json",
  "title": "YLX G0 event exact readback receipt R v1",
  "description": "Signed external terminal receipt for a separately authorized, strictly later exact readback of the G0 event bytes published by P.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "publication_receipt_ref",
    "publication_receipt_sha256",
    "reader_id",
    "readback_authority_ref",
    "readback_authority_sha256",
    "repository_locator",
    "target_scope",
    "event_ref",
    "event_sha256",
    "observed_event_sha256",
    "byte_length",
    "read_back_at",
    "result",
    "terminal_sink_id",
    "receipt_issuer_id",
    "signature_algorithm",
    "signing_key_id",
    "signed_payload_sha256",
    "signature"
  ],
  "properties": {
    "schema": {"const": "ylx.g0-policy-ratification-readback-receipt.v1"},
    "receipt_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"},
    "publication_receipt_ref": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "publication_receipt_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "reader_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "readback_authority_ref": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "readback_authority_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "repository_locator": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "target_scope": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "event_ref": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "event_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "observed_event_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "byte_length": {"type": "integer", "minimum": 2},
    "read_back_at": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"},
    "result": {"const": "MATCH"},
    "terminal_sink_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "receipt_issuer_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "signature_algorithm": {"const": "Ed25519"},
    "signing_key_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "signed_payload_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "signature": {"type": "string", "minLength": 88, "maxLength": 88, "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$"}
  }
}
