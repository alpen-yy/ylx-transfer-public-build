{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/release-reactivation-evidence-v1.schema.json",
  "title": "YLX release distribution reactivation evidence v1",
  "description": "Current, immutable compatibility and recovery evidence for reactivating distribution after a resolved incident. It binds the exact incident and resolution bytes, unchanged finalized release and channel scope, and the exact withdrawn or redirected predecessor control. PASS permits only a separately authorized and signed direct-successor ACTIVE control.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_id",
    "revision",
    "predecessor_evidence_ref",
    "incident_ref",
    "incident_resolution_ref",
    "finalized_release_binding",
    "channel_binding",
    "predecessor_control_ref",
    "evaluation_assignment_ref",
    "required_data_scope",
    "compatibility_window_sha256",
    "test_plan_ref",
    "evidence_refs",
    "result",
    "evaluated_at",
    "valid_until",
    "retained_data_disposition",
    "finalized_history_mutation",
    "reactivation_disposition",
    "artifact_metadata"
  ],
  "properties": {
    "schema": {
      "const": "ylx.release-reactivation-evidence.v1"
    },
    "evidence_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor_evidence_ref": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/reactivationEvidenceRef" }
      ]
    },
    "incident_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/release-incident-v1.schema.json#/$defs/releaseIncidentRef"
    },
    "incident_resolution_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/release-incident-resolution-v1.schema.json#/$defs/incidentResolutionRef"
    },
    "finalized_release_binding": {
      "$ref": "https://schemas.ylx.invalid/governance/release-operation-assignment-v2.schema.json#/$defs/finalizedReleaseBinding"
    },
    "channel_binding": {
      "$ref": "https://schemas.ylx.invalid/governance/release-operation-assignment-v2.schema.json#/$defs/channelBinding"
    },
    "predecessor_control_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/release-operation-assignment-v2.schema.json#/$defs/distributionControlRef"
    },
    "evaluation_assignment_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/release-operation-assignment-v2.schema.json#/$defs/releaseOperationAssignmentRef",
      "description": "The exact v2 assignment must authorize PUBLISH_REACTIVATION_EVIDENCE and bind this incident, resolution, finalized release, channel, and predecessor control procedurally."
    },
    "required_data_scope": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "compatibility_window_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "test_plan_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
      }
    },
    "result": {
      "enum": ["PASS", "FAIL"]
    },
    "evaluated_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "valid_until": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "retained_data_disposition": {
      "const": "PRESERVE_EXISTING_DATA"
    },
    "finalized_history_mutation": {
      "const": "FORBIDDEN"
    },
    "reactivation_disposition": {
      "enum": ["ELIGIBLE_FOR_SIGNED_DIRECT_SUCCESSOR_ONLY", "BLOCKED"]
    },
    "artifact_metadata": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactMetadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "revision": { "const": 1 } },
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "predecessor_evidence_ref": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "revision": { "type": "integer", "minimum": 2 },
          "predecessor_evidence_ref": { "$ref": "#/$defs/reactivationEvidenceRef" }
        }
      }
    },
    {
      "if": {
        "properties": { "result": { "const": "PASS" } },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "reactivation_disposition": {
            "const": "ELIGIBLE_FOR_SIGNED_DIRECT_SUCCESSOR_ONLY"
          }
        }
      },
      "else": {
        "properties": {
          "reactivation_disposition": { "const": "BLOCKED" }
        }
      }
    }
  ],
  "$defs": {
    "reactivationEvidenceRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "required": ["revision"],
          "properties": {
            "schema": { "const": "ylx.release-reactivation-evidence.v1" }
          }
        }
      ]
    }
  }
}
