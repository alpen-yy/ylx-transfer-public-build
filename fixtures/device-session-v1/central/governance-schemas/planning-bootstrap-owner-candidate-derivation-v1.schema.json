{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/planning-bootstrap-owner-candidate-derivation-v1.schema.json",
  "title": "YLX planning bootstrap Phase A owner candidate derivation v1",
  "description": "Authority-NONE record proving the deterministic Phase A owner payload digest derived from exact durable C and its pinned derivation contract. Ref/digest equality, RFC 8785 output reproduction, attempt joins, and chronology are procedural validation rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "derivation_id",
    "bootstrap_attempt_id",
    "input_closure_ref",
    "input_closure_sha256",
    "derivation_contract_ref",
    "derivation_contract_sha256",
    "owner_payload_sha256",
    "derived_at",
    "authority_effect"
  ],
  "properties": {
    "schema": {
      "const": "ylx.planning-bootstrap-owner-candidate-derivation.v1"
    },
    "derivation_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "bootstrap_attempt_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "input_closure_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "input_closure_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "derivation_contract_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "derivation_contract_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "owner_payload_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "derived_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "authority_effect": {
      "const": "NONE"
    }
  }
}
