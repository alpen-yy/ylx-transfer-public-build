          "$ref": "#/$defs/exactArtifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.binding-context.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      ]
    },
    "exactEvidenceRefMap": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
      },
      "patternProperties": {
        "^.+$": {
          "$ref": "#/$defs/exactEvidenceRef"
        }
      }
    },
    "exactEvidenceRef": {
      "description": "A closed exact byte reference to either a governance artifact or an externally governed source. Artifact revisions are optional because immutable families such as execution-context.v1 are not revisioned.",
      "oneOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sourceRef"
        }
      ]
    },
    "nullableExactEvidenceRef": {
