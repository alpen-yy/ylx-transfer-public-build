{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/execution-authorization-evaluation-v1.schema.json",
  "title": "YLX immutable execution authorization evaluation v1",
  "description": "A create-if-absent, post-publication evaluation of one schema-valid declared WBS action instance. Malformed, missing, multiple, unknown, or class/action-mismatched WBS declarations are rejected before evaluation and cannot be encoded by inventing valid declaration values. The WBS leaf carries only the class/action/authority/stop-rule declaration; this artifact binds the exact published planning bundle and WBS without introducing a self-digest cycle. PASS authorizes only the declared one-shot action instance, while FAIL is an immutable denied evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evaluation_id",
    "evaluated_at",
    "task_id",
    "leaf_declaration_sha256",
    "authorization_class",
    "authorization_action",
    "action_instance_id",
    "planned_action_input_sha256",
    "planning_bundle_ref",
    "planning_bundle_sha256",
    "delivery_wbs_ref",
    "delivery_wbs_sha256",
    "authorization_prerequisite_ref_by_kind",
    "authorization_prerequisite_sha256_by_kind",
    "authorization_environment_class",
    "authorization_environment_ref",
    "authorization_binding_context_ref",
    "authorization_binding_context_sha256",
    "authorization_authority_ref_by_artifact_id",
    "authorization_authority_sha256_by_artifact_id",
    "actor_assignment_ref",
    "actor_person_id",
    "authorization_stop_rules",
    "typed_predecessor_state_by_task_id",
    "phase_barrier_state_by_id",
    "validator_artifact_ref",
    "checker_assignment_ref",
    "result",
    "failure_codes",
    "authorizes_action",
    "artifact_metadata"
  ],
  "properties": {
    "schema": {
      "const": "ylx.execution-authorization-evaluation.v1"
    },
    "evaluation_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "evaluated_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "task_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "leaf_declaration_sha256": {
      "description": "Lowercase SHA-256 of RFC 8785 canonical JSON UTF-8 over exactly the selected WBS leaf's four-field execution_authorization declaration: authorization_class, authorization_action, authority_refs, and stop_rules. The procedural validator verifies that task_id selects that declaration in delivery_wbs_ref.",
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "authorization_class": {
      "$ref": "#/$defs/authorizationClass"
    },
    "authorization_action": {
      "$ref": "#/$defs/authorizationAction"
    },
    "action_instance_id": {
      "description": "Stable one-shot identifier for the concrete action attempt. Reuse with different inputs or a second effective evaluation is invalid.",
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "planned_action_input_sha256": {
      "description": "Lowercase SHA-256 of RFC 8785 canonical JSON UTF-8 over an object containing exactly task_id, leaf_declaration_sha256, authorization_class, authorization_action, action_instance_id, planning_bundle_ref, planning_bundle_sha256, delivery_wbs_ref, delivery_wbs_sha256, authorization_prerequisite_ref_by_kind, authorization_prerequisite_sha256_by_kind, authorization_environment_class, authorization_environment_ref, authorization_binding_context_ref, authorization_binding_context_sha256, authorization_authority_ref_by_artifact_id, authorization_authority_sha256_by_artifact_id, actor_assignment_ref, actor_person_id, authorization_stop_rules, typed_predecessor_state_by_task_id, and phase_barrier_state_by_id from this evaluation. No validator/checker provenance, result field, timestamp, metadata, or digest field is part of the preimage.",
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "planning_bundle_ref": {
      "$ref": "#/$defs/planningBundleRef"
    },
    "planning_bundle_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "delivery_wbs_ref": {
      "$ref": "#/$defs/deliveryWbsRef"
    },
    "delivery_wbs_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "authorization_prerequisite_ref_by_kind": {
      "$ref": "#/$defs/exactEvidenceRefMap"
    },
    "authorization_prerequisite_sha256_by_kind": {
      "$ref": "#/$defs/digestMap"
    },
    "authorization_environment_class": {
      "description": "Closed environment class is resolved by the procedural class/action policy because the repository does not define one universal environment enum across all seven authorization classes.",
      "$ref": "#/$defs/nullableIdentifier"
    },
    "authorization_environment_ref": {
      "$ref": "#/$defs/nullableExactEvidenceRef"
    },
    "authorization_binding_context_ref": {
      "description": "FAIL may record a null pair or a structurally valid mismatched evidence ref. PASS restricts null to the policy-defined M0/M1 stage-source actions and the pre-M2 bootstrap action, and otherwise requires a typed binding-context ref. The ref and digest must be null or non-null together.",
      "$ref": "#/$defs/nullableExactEvidenceRef"
    },
    "authorization_binding_context_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "authorization_authority_ref_by_artifact_id": {
      "description": "Closed map keyed by every artifact_id in the selected WBS declaration's authority_refs array. FAIL may preserve structurally valid mismatched evidence refs; PASS requires exact execution-authority.v1 artifact refs. Procedural validation requires an exact key-set match and proves every independent resolution and payload binding.",
      "$ref": "#/$defs/exactEvidenceRefMap"
    },
    "authorization_authority_sha256_by_artifact_id": {
      "description": "Closed digest map with exactly the same keys as authorization_authority_ref_by_artifact_id and the selected WBS declaration authority_refs artifact_id set.",
      "$ref": "#/$defs/digestMap"
    },
    "actor_assignment_ref": {
      "description": "FAIL may preserve a null or structurally valid mismatched artifact ref. PASS permits only an owner assignment or a release-operation-assignment.v2 selected procedurally for the declared action.",
      "$ref": "#/$defs/nullableExactArtifactRef"
    },
    "actor_person_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "authorization_stop_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authorizationStopRule"
      },
      "uniqueItems": true
    },
    "typed_predecessor_state_by_task_id": {
      "$ref": "#/$defs/typedPredecessorStateMap"
    },
    "phase_barrier_state_by_id": {
      "$ref": "#/$defs/phaseBarrierStateMap"
    },
    "validator_artifact_ref": {
      "$ref": "#/$defs/nullableExactEvidenceRef"
    },
    "checker_assignment_ref": {
      "description": "FAIL may preserve a null or structurally valid mismatched artifact ref. PASS requires the selected WBS leaf reviewer's owner-assignment.v1 ref.",
      "$ref": "#/$defs/nullableExactArtifactRef"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "failure_codes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failureCode"
      },
      "uniqueItems": true
    },
    "authorizes_action": {
      "description": "Null for FAIL. For PASS, the procedural validator requires exact equality with authorization_action; JSON Schema has no instance-field equality keyword.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/authorizationAction"
        }
      ]
    },
    "artifact_metadata": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactMetadata"
    }
  },
  "$defs": {
    "authorizationClass": {
      "enum": [
        "may_prepare",
        "may_implement",
        "may_deploy",
        "may_qualify",
        "may_enable_writer",
        "may_finalize_release",
        "may_control_distribution"
      ]
    },
    "authorizationAction": {
      "enum": [
        "preserve",
        "observe",
        "measure",
        "produce-governance-input",
        "run-disposable-prototype",
        "publish-planning-record",
        "implement-contract",
        "implement-product",
        "build-target-disabled",
        "assemble-m4-target",
        "run-integration-smoke",
        "install-target",
        "configure-target",
        "deploy-target-disabled",
        "publish-prerelease-rc",
        "deploy-writer-disabled-production",
        "execute-qualification",
        "collect-evidence",
        "issue-verdict",
        "publish-qualified-adapter-output",
        "rehearse-distribution-control",
        "enable-rp-ylx-production-target-writer",
        "assemble-release-projection",
        "collect-domain-attestations",
        "publish-pre-release-closure",
        "collect-release-quorum",
        "acquire-publication-fence",
        "promote-exact-rc",
        "publish-promotion-receipt",
        "publish-final-manifest",
        "cas-terminal-reference",
        "publish-aborted-termination",
        "publish-initial-active",
        "publish-withdrawn",
        "publish-redirected",
        "publish-reactivated-active"
      ]
    },
    "failureCode": {
      "enum": [
        "STALE_PLANNING_BUNDLE",
        "STALE_DELIVERY_WBS",
        "LEAF_DECLARATION_MISMATCH",
        "PREREQUISITE_MISSING",
        "PREREQUISITE_MISMATCH",
        "ENVIRONMENT_MISMATCH",
        "BINDING_CONTEXT_MISMATCH",
        "AUTHORITY_MISMATCH",
        "ACTOR_ASSIGNMENT_MISMATCH",
        "TYPED_PREDECESSOR_UNSATISFIED",
        "PHASE_BARRIER_UNSATISFIED",
        "STOP_RULE_EVIDENCE_MISMATCH",
        "STOP_RULE_TRIGGERED",
        "PREMATURE_WRITER_ENABLE",
        "PREMATURE_RELEASE_FINALIZATION",
        "PREMATURE_DISTRIBUTION_CONTROL",
        "QUALIFICATION_PREFIX_ESCAPE",
        "ACTION_INSTANCE_REPLAY",
        "PLANNED_ACTION_INPUT_MISMATCH",
        "VALIDATOR_MISMATCH",
        "CHECKER_ASSIGNMENT_MISMATCH"
      ]
    },
    "exactArtifactRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "required": [
            "revision"
          ]
        }
      ]
    },
    "ownerAssignmentRef": {
      "allOf": [
        {
          "$ref": "#/$defs/exactArtifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.owner-assignment.v1"
            }
          },
          "required": [
            "schema"
          ]
        }
      ]
    },
    "releaseOperationAssignmentV2Ref": {
      "allOf": [
        {
          "$ref": "#/$defs/exactArtifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.release-operation-assignment.v2"
            }
          },
          "required": [
            "schema"
          ]
        }
      ]
    },
    "actorAssignmentRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/ownerAssignmentRef"
        },
        {
          "$ref": "#/$defs/releaseOperationAssignmentV2Ref"
        }
      ]
    },
    "checkerAssignmentRef": {
      "$ref": "#/$defs/ownerAssignmentRef"
    },
    "nullableExactArtifactRef": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/exactArtifactRef"
        }
      ]
    },
    "planningBundleRef": {
      "allOf": [
        {
          "$ref": "#/$defs/exactArtifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.delivery-planning-bundle.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "deliveryWbsRef": {
      "allOf": [
        {
          "$ref": "#/$defs/exactArtifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.delivery-wbs.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
