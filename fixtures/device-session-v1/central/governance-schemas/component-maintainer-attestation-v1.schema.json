{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/component-maintainer-attestation-v1.schema.json",
  "title": "YLX component maintainer attestation v1",
  "description": "Boundary-specific maintainer authority attestation binding one signer, component artifact, actual deployment, execution contexts, and exact M5 binding context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "boundary_id",
    "component_artifact_owner",
    "component_maintainer_subrole",
    "binding_context_ref",
    "execution_context_refs",
    "component_artifact_identity",
    "component_artifact_sha256",
    "deployed_environment_identity",
    "deployment_record_sha256",
    "signer_identity",
    "signing_key_fingerprint",
    "role_assignment_artifact_sha256",
    "role_assignment_revision",
    "signing_policy_sha256",
    "key_validity_revocation_head_sha256",
    "signed_at"
  ],
  "properties": {
    "schema": {
      "const": "ylx.component-maintainer-attestation.v1"
    },
    "boundary_id": {
      "$ref": "https://schemas.ylx.invalid/governance/consumer-boundary-registry-v1.schema.json#/$defs/boundaryId"
    },
    "component_artifact_owner": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "component_maintainer_subrole": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "binding_context_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/consumer-boundary-acceptance-v1.schema.json#/$defs/bindingContextRef"
    },
    "execution_context_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/consumer-boundary-acceptance-v1.schema.json#/$defs/executionContextRef"
      }
    },
    "component_artifact_identity": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "component_artifact_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "deployed_environment_identity": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "deployment_record_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "signer_identity": {
      "$ref": "#/$defs/signerIdentity"
    },
    "signing_key_fingerprint": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "role_assignment_artifact_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "role_assignment_revision": {
      "type": "integer",
      "minimum": 1
    },
    "signing_policy_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "key_validity_revocation_head_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "signed_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    }
  },
  "$defs": {
    "signerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_id",
        "natural_person_identity_sha256",
        "identity_authority_ref"
      ],
      "properties": {
        "person_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "natural_person_identity_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "identity_authority_ref": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/authorityRef"
        }
      }
    }
  }
}
