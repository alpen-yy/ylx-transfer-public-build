{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/natural-person-identity-authority-v1.schema.json",
  "title": "YLX natural-person identity authority record v1",
  "description": "One immutable, pseudonymous natural-person identity authority record. Its RFC 8785 exact-byte digest is the natural_person_identity_sha256 used by assignments and signatures; the digest is carried by referring artifacts and is never embedded as a self hash. Raw names, email addresses, phone numbers, credentials, and other direct PII are outside this record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority_record_id",
    "identity_authority_id",
    "person_id",
    "revision",
    "predecessor_identity_authority_ref",
    "identity_claim_sha256",
    "source_authority_refs",
    "accountable_natural_person",
    "subject_status",
    "effective_from",
    "not_after",
    "revoked_at",
    "revocation_reason",
    "verification_method",
    "verified_at",
    "privacy_profile",
    "artifact_metadata"
  ],
  "properties": {
    "schema": {
      "const": "ylx.natural-person-identity-authority.v1"
    },
    "authority_record_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "identity_authority_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "person_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor_identity_authority_ref": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/identityAuthorityRef" }
      ]
    },
    "identity_claim_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256",
      "description": "Digest of the authority-owned identity assertion used to establish that person_id names one accountable natural person. The private assertion bytes are not copied here."
    },
    "source_authority_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identitySourceRef"
      }
    },
    "accountable_natural_person": {
      "const": true
    },
    "subject_status": {
      "enum": ["ACTIVE", "REVOKED"]
    },
    "effective_from": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "not_after": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp" }
      ]
    },
    "revoked_at": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp" }
      ]
    },
    "revocation_reason": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 600 }
      ]
    },
    "verification_method": {
      "enum": [
        "AUTHORITATIVE_DIRECTORY_ASSERTION",
        "IN_PERSON_ORGANIZATIONAL_VERIFICATION",
        "FEDERATED_IDENTITY_ASSERTION"
      ]
    },
    "verified_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "privacy_profile": {
      "const": "PSEUDONYMOUS_STABLE_ID_NO_RAW_PII"
    },
    "artifact_metadata": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactMetadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "revision": { "const": 1 } },
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "predecessor_identity_authority_ref": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "revision": { "type": "integer", "minimum": 2 },
          "predecessor_identity_authority_ref": {
            "$ref": "#/$defs/identityAuthorityRef"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "subject_status": { "const": "ACTIVE" } },
        "required": ["subject_status"]
      },
      "then": {
        "properties": {
          "revoked_at": { "type": "null" },
          "revocation_reason": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "revoked_at": {
            "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
          },
          "revocation_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    }
  ],
  "$defs": {
    "identityAuthorityRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "required": ["revision"],
          "properties": {
            "schema": {
              "const": "ylx.natural-person-identity-authority.v1"
            }
          }
        }
      ]
    },
    "identitySourceRef": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sourceRef"
            },
            {
              "required": ["authority_kind"],
              "properties": {
                "authority_kind": { "const": "identity-authority" }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sourceRef"
            },
            {
              "required": ["authority_kind"],
              "properties": {
                "authority_kind": { "const": "external-organizational-authority" }
              }
            }
          ]
        }
      ]
    }
  }
}
