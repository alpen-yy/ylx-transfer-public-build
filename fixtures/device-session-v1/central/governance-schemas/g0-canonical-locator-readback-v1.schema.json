{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/g0-canonical-locator-readback-v1.schema.json",
  "title": "YLX G0 canonical governance locator and clean commit readback v1",
  "description": "Signed terminal observation of the pre-subject repository locator, clean commit identity/tree digest, and exact five-path byte map. It contains no subject, approval, or event digest and can therefore predate the four-key subject without a cycle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "repository_locator",
    "subject_commit_id",
    "subject_commit_tree_sha256",
    "exact_five_path_sha256_by_path",
    "commit_operation_receipt_ref",
    "commit_operation_receipt_sha256",
    "reader_id",
    "readback_authority_ref",
    "readback_authority_sha256",
    "target_scope",
    "observed_commit_id",
    "observed_commit_tree_sha256",
    "observed_five_path_sha256_by_path",
    "read_back_at",
    "result",
    "terminal_sink_id",
    "receipt_issuer_id",
    "signature_algorithm",
    "signing_key_id",
    "signed_payload_sha256",
    "signature"
  ],
  "properties": {
    "schema": {"const": "ylx.g0-canonical-locator-readback.v1"},
    "receipt_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"},
    "repository_locator": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "subject_commit_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "subject_commit_tree_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "exact_five_path_sha256_by_path": {"$ref": "#/$defs/fivePathDigestMap"},
    "commit_operation_receipt_ref": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "commit_operation_receipt_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "reader_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "readback_authority_ref": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "readback_authority_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "target_scope": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "observed_commit_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "observed_commit_tree_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "observed_five_path_sha256_by_path": {"$ref": "#/$defs/fivePathDigestMap"},
    "read_back_at": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"},
    "result": {"const": "EXACT_COMMIT_TREE_AND_FIVE_PATH_BYTES_MATCH"},
    "terminal_sink_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "receipt_issuer_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "signature_algorithm": {"const": "Ed25519"},
    "signing_key_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "signed_payload_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "signature": {"type": "string", "minLength": 88, "maxLength": 88, "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$"}
  },
  "$defs": {
    "fivePathDigestMap": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 5,
      "maxProperties": 5,
      "propertyNames": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
      "patternProperties": {"^.+$": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"}}
    }
  }
}
