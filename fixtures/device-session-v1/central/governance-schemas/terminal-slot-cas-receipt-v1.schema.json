{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/terminal-slot-cas-receipt-v1.schema.json",
  "title": "YLX terminal slot compare-and-set receipt v1",
  "description": "Immutable receipt for the FINALIZED terminal-reference compare-and-set. The operation is authorized only by checkpoint 7, taken immediately before CAS after exact manifest publication and readback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "attempt_id",
    "attempt_input_set_ref",
    "authorizing_freshness_checkpoint_ref",
    "authorizing_freshness_checkpoint_sequence",
    "pre_cas_checkpoint_ref",
    "pre_cas_checkpoint_sequence",
    "planned_action_input_sha256",
    "manifest_readback_receipt_ref",
    "terminal_slot",
    "expected_slot_state",
    "requested_terminal_reference",
    "cas_authority_ref",
    "cas_operation_id",
    "observed_slot_version",
    "observed_etag",
    "operation_result",
    "cas_completed_at",
    "artifact_metadata"
  ],
  "properties": {
    "schema": {
      "const": "ylx.terminal-slot-cas-receipt.v1"
    },
    "receipt_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "attempt_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "attempt_input_set_ref": {
      "$ref": "#/$defs/attemptInputSetRef"
    },
    "authorizing_freshness_checkpoint_ref": {
      "$ref": "#/$defs/freshnessCheckpointRef",
      "description": "Procedurally equal to pre_cas_checkpoint_ref."
    },
    "authorizing_freshness_checkpoint_sequence": {
      "const": 7
    },
    "pre_cas_checkpoint_ref": {
      "$ref": "#/$defs/freshnessCheckpointRef"
    },
    "pre_cas_checkpoint_sequence": {
      "const": 7
    },
    "planned_action_input_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "manifest_readback_receipt_ref": {
      "$ref": "#/$defs/manifestReadbackReceiptRef"
    },
    "terminal_slot": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "expected_slot_state": {
      "const": "ABSENT"
    },
    "requested_terminal_reference": {
      "$ref": "#/$defs/finalizedTerminalReference"
    },
    "cas_authority_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/authorityRef"
    },
    "cas_operation_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "observed_slot_version": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "observed_etag": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "operation_result": {
      "enum": [
        "CREATED_EXACT",
        "ALREADY_EXACT"
      ]
    },
    "cas_completed_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "artifact_metadata": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactMetadata"
    }
  },
  "$defs": {
    "attemptInputSetRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.release-attempt-input-set.v1"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "freshnessCheckpointRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.release-freshness-checkpoint.v1"
            }
          },
          "required": [
            "schema"
          ]
        }
      ]
    },
    "manifestReadbackReceiptRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.content-addressed-readback-receipt.v1"
            }
          },
          "required": [
            "schema"
          ]
        }
      ]
    },
    "releaseManifestRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.release-closure-manifest.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "finalizedTerminalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload_ref",
        "payload_locator",
        "payload_sha256"
      ],
      "properties": {
        "kind": {
          "const": "FINALIZED"
        },
        "payload_ref": {
          "$ref": "#/$defs/releaseManifestRef"
        },
        "payload_locator": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
        },
        "payload_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
