          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/authorityRef"
        }
      }
    },
    "approvedHardwareOwnerApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "principal_id",
        "decision",
        "approved_at",
        "assignment_ref"
      ],
      "properties": {
        "role_id": {
          "const": "hardware-owner"
        },
        "principal_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "decision": {
          "const": "APPROVED"
        },
        "approved_at": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
        },
        "assignment_ref": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/authorityRef"
        }
      }
    },
    "approvedPipelineOwnerApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "principal_id",
