        }
      }
    },
    "issueSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overview_start_byte",
        "overview_end_byte",
        "overview_sha256",
        "body_start_byte",
        "body_end_byte",
        "body_sha256"
      ],
      "properties": {
        "overview_start_byte": { "type": "integer", "minimum": 0 },
        "overview_end_byte": { "type": "integer", "minimum": 1 },
        "overview_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "body_start_byte": { "type": "integer", "minimum": 0 },
        "body_end_byte": { "type": "integer", "minimum": 1 },
        "body_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
