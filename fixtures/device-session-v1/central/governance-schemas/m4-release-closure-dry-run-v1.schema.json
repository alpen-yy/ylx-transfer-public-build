                      }
                    }
                  },
                  "build": {
                    "properties": {
                      "outcome": {
                        "const": "PASS"
                      }
                    }
                  },
                  "install": {
                    "properties": {
                      "outcome": {
                        "const": "PASS"
                      }
                    }
                  },
                  "configure": {
                    "properties": {
                      "outcome": {
                        "const": "PASS"
                      }
                    }
                  },
                  "deploy": {
                    "properties": {
                      "outcome": {
                        "const": "PASS"
                      }
                    }
                  },
