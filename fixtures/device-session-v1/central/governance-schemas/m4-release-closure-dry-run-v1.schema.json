{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/m4-release-closure-dry-run-v1.schema.json",
  "title": "YLX no-production M4 release-closure dry-run v1",
  "description": "Independently exercises the pinned M2 governance contract and a separately built M4 release control plane against one exact M4 binding context. The control plane is outside the four product components and product candidate identity. This dry-run may run beside component qualification, is not product assembly input, and must pass before M4 aggregation without any production access or side effect; M5 production qualification remains separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dry_run_id",
    "revision",
    "predecessor_sha256",
    "created_at",
    "artifact_path",
    "artifact_metadata",
    "m4_binding_context_ref",
    "m4_binding_projection",
    "m2_contract_package_ref",
    "control_plane_provenance",
    "no_production_execution",
    "governance_schema_probe",
    "governance_validator_probe",
    "issue_probe",
    "mapping_probe",
    "component_probe",
    "closure_probe",
    "component_qualification_relation",
    "required_before",
    "overall_outcome",
    "diagnostics",
    "approvals",
    "completed_at"
  ],
  "properties": {
    "schema": {
      "const": "ylx.m4-release-closure-dry-run.v1"
    },
    "dry_run_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      ]
    },
    "created_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "artifact_path": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "artifact_metadata": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactMetadata"
    },
    "m4_binding_context_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
    },
    "m4_binding_projection": {
      "$ref": "#/$defs/m4BindingProjection"
    },
    "m2_contract_package_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
    },
    "control_plane_provenance": {
      "$ref": "#/$defs/controlPlaneProvenance"
    },
    "no_production_execution": {
      "$ref": "#/$defs/noProductionExecution"
    },
    "governance_schema_probe": {
      "$ref": "#/$defs/governanceSchemaProbe"
    },
    "governance_validator_probe": {
      "$ref": "#/$defs/governanceValidatorProbe"
    },
    "issue_probe": {
      "$ref": "#/$defs/issueProbe"
    },
    "mapping_probe": {
      "$ref": "#/$defs/mappingProbe"
    },
    "component_probe": {
      "$ref": "#/$defs/componentProbe"
    },
    "closure_probe": {
      "$ref": "#/$defs/closureProbe"
    },
    "component_qualification_relation": {
      "const": "MAY_RUN_IN_PARALLEL"
    },
    "required_before": {
      "const": "M4_AGGREGATE"
    },
    "overall_outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      },
      "uniqueItems": true
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract-owner",
        "release-owner",
        "qa-evidence-owner"
      ],
      "properties": {
        "contract-owner": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/approval"
        },
        "release-owner": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/approval"
        },
        "qa-evidence-owner": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/approval"
        }
      }
    },
    "completed_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_outcome": {
            "const": "PASS"
          }
        },
        "required": [
          "overall_outcome"
        ]
      },
      "then": {
        "properties": {
          "governance_schema_probe": {
            "properties": {
              "execution": {
                "properties": {
                  "outcome": {
                    "const": "PASS"
                  }
                }
              }
            }
          },
          "governance_validator_probe": {
            "properties": {
              "execution": {
                "properties": {
                  "outcome": {
                    "const": "PASS"
                  }
                }
              }
            }
          },
          "issue_probe": {
            "properties": {
              "execution": {
                "properties": {
                  "outcome": {
                    "const": "PASS"
                  }
                }
              }
            }
          },
          "mapping_probe": {
            "properties": {
              "execution": {
                "properties": {
                  "outcome": {
                    "const": "PASS"
                  }
                }
              }
            }
          },
          "component_probe": {
            "properties": {
              "execution": {
                "properties": {
                  "outcome": {
                    "const": "PASS"
                  }
                }
              }
            }
          },
          "closure_probe": {
            "properties": {
              "outcome": {
                "const": "PASS"
              }
            }
          },
          "control_plane_provenance": {
            "properties": {
              "outcome": {
                "const": "PASS"
              }
            }
          },
          "diagnostics": {
            "maxItems": 0
          },
          "approvals": {
            "properties": {
              "contract-owner": {
                "properties": {
                  "decision": {
                    "const": "APPROVED"
                  }
                }
              },
              "release-owner": {
                "properties": {
                  "decision": {
                    "const": "APPROVED"
                  }
                }
              },
              "qa-evidence-owner": {
                "properties": {
                  "decision": {
                    "const": "APPROVED"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "diagnostics": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "m4BindingProjection": {
