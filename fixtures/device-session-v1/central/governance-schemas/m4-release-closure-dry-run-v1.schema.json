        },
        {
          "properties": {
            "schema": {
              "const": "ylx.release-controller-build.v1"
            }
          },
          "required": [
            "schema"
          ]
        }
      ]
    },
    "customerVisibleResolverArtifactRef": {
      "allOf": [
