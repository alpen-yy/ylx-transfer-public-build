        },
        "product_component": {
          "const": false
        },
        "m4_candidate_identity_member": {
          "const": false
        }
      }
    },
    "controlPlaneExactBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_id",
        "build_provenance_ref",
        "source_sha256",
        "build_sha256",
        "release_controller_artifact_ref",
        "customer_visible_resolver_artifact_ref",
        "artifact_set_sha256"
      ],
      "properties": {
        "build_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
        },
        "build_provenance_ref": {
          "$ref": "#/$defs/exactArtifactRef"
        },
        "source_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "build_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "release_controller_artifact_ref": {
          "$ref": "#/$defs/releaseControllerArtifactRef"
        },
        "customer_visible_resolver_artifact_ref": {
          "$ref": "#/$defs/customerVisibleResolverArtifactRef"
        },
        "artifact_set_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      }
    },
    "controlPlaneRenderedConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
