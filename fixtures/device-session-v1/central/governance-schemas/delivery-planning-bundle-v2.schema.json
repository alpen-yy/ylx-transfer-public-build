{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/delivery-planning-bundle-v2.schema.json",
  "title": "YLX rolling-wave delivery planning bundle v2",
  "description": "Binds the exact rolling-wave planning inputs for one gate. An M5 FINAL_ACTUAL_VARIANCE bundle carries the approved content reconciliation for every executable leaf except the one external publisher leaf. That final publisher actual and variance are recorded later by the exact publication receipt, and durable closure exists only after the matching publication and readback receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_id",
    "revision",
    "predecessor_sha256",
    "generated_at",
    "source_refs",
    "artifact_metadata",
    "planning_approval_subject_sha256",
    "planning_bundle_approval_by_role",
    "planning_gate",
    "detail_horizon",
    "registry_binding",
    "artifacts",
    "bundle_kind",
    "final_actual_variance_reconciliation",
    "overall_status"
  ],
  "properties": {
    "schema": {
      "const": "ylx.delivery-planning-bundle.v2"
    },
    "artifact_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "generated_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp",
      "description": "Assembly time of the exact approval-bearing bundle. For the governed revision-1 bootstrap it is after every referenced approval has durable P/R; legacy-compatible bundles retain their embedded-approval chronology. It is deliberately excluded from the pre-approval semantic subject, and procedural validation still enforces revision chronology, assignment validity, and publication ordering."
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sourceRef"
      },
      "uniqueItems": true
    },
    "artifact_metadata": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactMetadata"
    },
    "planning_approval_subject_ref": {
      "description": "Content-addressed stable locator of the separately published wrapperless planning approval subject S.",
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "planning_approval_subject_sha256": {
      "description": "Lowercase SHA-256 of RFC 8785 canonical JSON UTF-8 over exactly schema, artifact_id, revision, predecessor_sha256, source_refs, artifact_metadata, planning_gate, detail_horizon, registry_binding, artifacts, bundle_kind, and final_actual_variance_reconciliation. generated_at is excluded because it records assembly of the approval-bearing exact bundle after the approvals; planning_approval_subject_ref, the approval map, this subject digest, overall_status, the bundle's final raw digest and locator, and every downstream receipt or verdict are also excluded.",
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "planning_bundle_approval_by_role": {
      "$ref": "#/$defs/planningApprovalByRole"
    },
    "planning_gate": {
      "$ref": "#/$defs/gate"
    },
    "detail_horizon": {
      "$ref": "#/$defs/detailHorizon"
    },
    "registry_binding": {
      "$ref": "#/$defs/registryBinding"
    },
    "artifacts": {
      "$ref": "#/$defs/artifactMap"
    },
    "bundle_kind": {
      "enum": [
        "ROLLING_WAVE",
        "FINAL_ACTUAL_VARIANCE"
      ]
    },
    "final_actual_variance_reconciliation": {
      "$ref": "#/$defs/nullableFinalReconciliation"
    },
    "overall_status": {
      "enum": [
        "ACCEPTED",
        "INPUT_BLOCKED"
      ]
    }
  },
  "$defs": {
    "nullableSha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      ]
    },
    "nullableTimestamp": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
        }
      ]
    },
    "gate": {
      "enum": [
        "M0",
        "M1",
        "M2",
        "M3",
        "M4",
        "M5"
      ]
    },
    "futureGate": {
      "enum": [
        "M1",
        "M2",
        "M3",
        "M4",
        "M5"
      ]
    },
    "detailHorizon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_gate",
        "executable_through_gate",
        "next_expansion_gate",
        "registry_id_set_sha256",
        "requirement_cardinality"
      ],
      "properties": {
        "planning_gate": {
          "$ref": "#/$defs/gate"
        },
        "executable_through_gate": {
          "$ref": "#/$defs/gate"
        },
        "next_expansion_gate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/futureGate"
            }
          ]
        },
        "registry_id_set_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "requirement_cardinality": {
          "const": 173
        }
      }
    },
    "registryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_revision",
        "registry_artifact_path",
        "registry_artifact_sha256",
        "registry_id_set_sha256",
        "registry_cardinality"
      ],
      "properties": {
        "registry_revision": {
          "type": "integer",
          "minimum": 1
        },
        "registry_artifact_path": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
        },
        "registry_artifact_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "registry_id_set_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "registry_cardinality": {
          "const": 173
        }
      }
    },
    "exactArtifactRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "required": [
            "revision"
          ]
        }
      ]
    },
    "typedArtifactRef": {
      "required": [
        "artifact_id",
        "schema",
        "revision",
        "artifact_path",
        "artifact_sha256"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/exactArtifactRef"
        }
      ]
    },
    "ownerAssignmentRef": {
      "allOf": [
        {
          "$ref": "#/$defs/typedArtifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.owner-assignment.v1"
            }
          }
        }
      ]
    },
    "resourceCalendarRef": {
      "allOf": [
        {
          "$ref": "#/$defs/typedArtifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.resource-calendar.v1"
            }
          }
        }
      ]
    },
    "deliveryWbsRef": {
      "allOf": [
        {
          "$ref": "#/$defs/typedArtifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.delivery-wbs.v2"
            }
          }
        }
      ]
    },
    "forecastSnapshotRef": {
      "allOf": [
        {
          "$ref": "#/$defs/typedArtifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.forecast-snapshot.v1"
            }
          }
        }
      ]
    },
    "artifactMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_assignment",
        "resource_calendar",
        "delivery_wbs",
        "forecast_snapshot"
      ],
      "properties": {
        "owner_assignment": {
          "$ref": "#/$defs/ownerAssignmentRef"
        },
        "resource_calendar": {
          "$ref": "#/$defs/resourceCalendarRef"
        },
        "delivery_wbs": {
          "$ref": "#/$defs/deliveryWbsRef"
        },
        "forecast_snapshot": {
          "$ref": "#/$defs/forecastSnapshotRef"
        }
      }
    },
    "artifactDigestMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_assignment",
        "resource_calendar",
        "delivery_wbs",
        "forecast_snapshot"
      ],
      "properties": {
        "owner_assignment": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "resource_calendar": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "delivery_wbs": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "forecast_snapshot": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      }
    },
    "planningApprovalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "principal_id",
        "natural_person_id",
        "decision",
        "approved_at",
        "assignment_ref",
        "planning_approval_subject_sha256",
        "bundle_revision",
        "predecessor_sha256",
        "artifact_sha256_by_kind",
        "owner_assignment_revision",
        "approval_evidence_ref"
      ],
      "properties": {
        "role_id": {
          "enum": [
            "release-owner",
            "build-platform-owner",
            "qa-evidence-owner"
          ]
        },
        "principal_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "natural_person_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "decision": {
          "const": "APPROVED"
        },
        "approved_at": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
        },
        "assignment_ref": {
          "$ref": "#/$defs/ownerAssignmentRef"
        },
        "planning_approval_subject_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "bundle_revision": {
          "type": "integer",
          "minimum": 1
        },
        "predecessor_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "artifact_sha256_by_kind": {
          "$ref": "#/$defs/artifactDigestMap"
        },
        "owner_assignment_revision": {
          "type": "integer",
          "minimum": 1
        },
        "approval_evidence_ref": {
          "$ref": "#/$defs/exactArtifactRef"
        }
      }
    },
    "completePlanningApprovalByRole": {
      "description": "The three records must resolve through the effective owner assignment to three distinct natural persons and must bind the same subject, bundle revision, predecessor, and four child digests. Those cross-record equalities are checked procedurally after schema validation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release-owner",
        "build-platform-owner",
        "qa-evidence-owner"
      ],
      "properties": {
        "release-owner": {
          "allOf": [
            {
              "$ref": "#/$defs/planningApprovalRecord"
            },
            {
              "properties": {
                "role_id": {
                  "const": "release-owner"
                }
              }
            }
          ]
        },
        "build-platform-owner": {
          "allOf": [
            {
              "$ref": "#/$defs/planningApprovalRecord"
            },
            {
              "properties": {
                "role_id": {
                  "const": "build-platform-owner"
                }
              }
            }
          ]
        },
        "qa-evidence-owner": {
          "allOf": [
            {
              "$ref": "#/$defs/planningApprovalRecord"
            },
            {
              "properties": {
                "role_id": {
                  "const": "qa-evidence-owner"
                }
              }
            }
          ]
        }
      }
    },
    "planningApprovalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_ref",
        "approval_sha256",
        "publication_receipt_ref",
        "publication_receipt_sha256",
        "readback_receipt_ref",
        "readback_receipt_sha256"
      ],
      "properties": {
        "approval_ref": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
        },
        "approval_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "publication_receipt_ref": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
        },
        "publication_receipt_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "readback_receipt_ref": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
        },
        "readback_receipt_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        }
      }
    },
    "completeBootstrapPlanningApprovalByRole": {
      "description": "Exact governed-bootstrap map of the three separately published planning approvals and each approval's durable publication/readback receipts.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release-owner",
        "build-platform-owner",
        "qa-evidence-owner"
      ],
      "properties": {
        "release-owner": {
          "$ref": "#/$defs/planningApprovalReference"
        },
        "build-platform-owner": {
          "$ref": "#/$defs/planningApprovalReference"
        },
        "qa-evidence-owner": {
          "$ref": "#/$defs/planningApprovalReference"
        }
      }
    },
    "emptyPlanningApprovalByRole": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "legacyPlanningApprovalByRole": {
      "oneOf": [
        {
          "$ref": "#/$defs/emptyPlanningApprovalByRole"
        },
        {
          "$ref": "#/$defs/completePlanningApprovalByRole"
        }
      ]
    },
    "acceptedPlanningApprovalByRole": {
      "oneOf": [
        {
          "$ref": "#/$defs/completePlanningApprovalByRole"
        },
        {
          "$ref": "#/$defs/completeBootstrapPlanningApprovalByRole"
        }
      ]
    },
    "planningApprovalByRole": {
      "description": "INPUT_BLOCKED legacy-compatible bundles use the empty object. ACCEPTED legacy-compatible bundles use embedded approval records, while the governed revision-1 bootstrap uses external approval/P/R references.",
      "oneOf": [
        {
          "$ref": "#/$defs/legacyPlanningApprovalByRole"
        },
        {
          "$ref": "#/$defs/completeBootstrapPlanningApprovalByRole"
        }
      ]
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        }
      }
    },
    "signedDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        }
      }
    },
    "capacityWindowUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "window_id",
        "used_quantity",
        "capacity_unit",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "resource_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "window_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "used_quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "capacity_unit": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "started_at": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
        },
        "finished_at": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
        }
      }
    },
    "hardwareWindowUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardware_id",
        "window_id",
        "started_at",
        "finished_at",
        "evidence_ref"
      ],
      "properties": {
        "hardware_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "window_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "started_at": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
        },
        "finished_at": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
        },
        "evidence_ref": {
          "$ref": "#/$defs/exactArtifactRef"
        }
      }
    },
    "credentialWindowUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_id",
        "window_id",
        "started_at",
        "finished_at",
        "evidence_ref"
      ],
      "properties": {
        "credential_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "window_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "started_at": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
        },
        "finished_at": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
        },
        "evidence_ref": {
          "$ref": "#/$defs/exactArtifactRef"
        }
      }
    },
    "executedTaskActual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_status",
        "actual_started_at",
        "actual_finished_at",
        "actual_effort",
        "actual_fixed_elapsed",
        "actual_capacity_usage",
        "actual_hardware_usage",
        "actual_credential_window_usage",
        "actual_blocked_elapsed",
        "actual_wait_elapsed",
        "terminal_evidence_refs"
      ],
      "properties": {
        "terminal_status": {
          "enum": [
            "COMPLETED",
            "FAILED"
          ]
        },
        "actual_started_at": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
        },
        "actual_finished_at": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
        },
        "actual_effort": {
          "$ref": "#/$defs/duration"
        },
        "actual_fixed_elapsed": {
          "$ref": "#/$defs/duration"
        },
        "actual_capacity_usage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capacityWindowUse"
          },
          "uniqueItems": true
        },
        "actual_hardware_usage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hardwareWindowUse"
          },
          "uniqueItems": true
        },
        "actual_credential_window_usage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/credentialWindowUse"
          },
          "uniqueItems": true
        },
        "actual_blocked_elapsed": {
          "$ref": "#/$defs/duration"
        },
        "actual_wait_elapsed": {
          "$ref": "#/$defs/duration"
        },
        "terminal_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exactArtifactRef"
          },
          "uniqueItems": true
        }
      }
    },
    "nonexecutedTaskActual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_status",
        "reason",
        "replacement_ref",
        "terminal_evidence_refs"
      ],
      "properties": {
        "terminal_status": {
          "enum": [
            "CANCELLED",
            "SUPERSEDED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "replacement_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/exactArtifactRef"
            }
          ]
        },
        "terminal_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/exactArtifactRef"
          },
          "uniqueItems": true
        }
      }
    },
    "taskActual": {
      "oneOf": [
        {
          "$ref": "#/$defs/executedTaskActual"
        },
        {
          "$ref": "#/$defs/nonexecutedTaskActual"
        }
      ]
    },
    "taskActualMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
      },
      "patternProperties": {
        "^.+$": {
          "$ref": "#/$defs/taskActual"
        }
      },
      "additionalProperties": false
    },
    "milestoneVariance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestone_gate",
        "planned_start",
        "actual_start",
        "start_variance",
        "planned_finish",
        "actual_finish",
        "finish_variance",
        "planned_effort",
        "actual_effort",
        "effort_variance",
        "planned_fixed_elapsed",
        "actual_fixed_elapsed",
        "fixed_elapsed_variance"
      ],
      "properties": {
        "milestone_gate": {
          "$ref": "#/$defs/gate"
        },
        "planned_start": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
        },
        "actual_start": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
        },
