    "publisherClosure": {
      "description": "Non-recursive declaration of the one still-unexecuted external publisher leaf for this approved content reconciliation. F contains no execution evaluation, action instance, actor, publisher actual, publication receipt, readback receipt, self digest, or locator. After exact approval-bearing F bytes exist, a pre-action PASS evaluation must bind F and its selected WBS; P records the publisher actual and variance and durable publication, and R exact-refers to P and proves F readback.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_node_id",
        "protocol",
        "publication_receipt_schema",
        "readback_receipt_schema"
      ],
      "properties": {
        "task_node_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "protocol": {
          "const": "EXTERNAL_CONTENT_ADDRESSED_PUBLICATION_READBACK_V1"
        },
        "publication_receipt_schema": {
          "const": "ylx.final-actual-variance-publication-receipt.v1"
        },
        "readback_receipt_schema": {
          "const": "ylx.final-actual-variance-readback-receipt.v1"
        }
      }
    },
    "finalReconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reconciliation_revision",
        "predecessor_reconciliation_sha256",
        "planned_bundle_ref",
        "variance_baseline_bundle_sha256",
        "accepted_forecast_history",
        "task_node_count",
        "terminal_task_actual_count",
        "planned_task_node_id_set_sha256",
        "actual_task_node_id_set_sha256",
        "task_actual_by_node_id",
        "task_variance_by_node_id",
        "milestone_variances",
        "resource_window_variances",
        "dependency_critical_path",
        "resource_levelled_driving_path",
        "forecast_error",
        "unmaterialized_scenario_dispositions",
        "variance_reason_by_id",
        "publisher_closure",
        "reconciled_at",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "const": "CONTENT_RECONCILED_PENDING_DURABILITY",
          "description": "All non-publisher executable-leaf actuals and variances are reconciled and approved as F content. This is not durable publication, readback, release completion, or a terminal planning closure; the one publisher actual and variance exist only in P and durability additionally requires R."
        },
        "reconciliation_revision": {
          "type": "integer",
          "minimum": 1
        },
        "predecessor_reconciliation_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "planned_bundle_ref": {
          "$ref": "#/$defs/planningBundleRef"
        },
        "variance_baseline_bundle_sha256": {
          "description": "Exact digest of the accepted M4-to-M5 entry plan; post-hoc rebaselines are invalid.",
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "accepted_forecast_history": {
          "description": "Complete, ordered accepted forecast-snapshot chain through the last M5 planning head. Chain completeness and direct-predecessor order are checked procedurally.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/forecastSnapshotRef"
          },
          "uniqueItems": true
        },
        "task_node_count": {
          "type": "integer",
          "minimum": 1
        },
        "terminal_task_actual_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Count of terminal actuals embedded in F. Procedural validation requires exactly one fewer than the executable-leaf count because publisher_closure.task_node_id remains unexecuted until P."
        },
        "planned_task_node_id_set_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "actual_task_node_id_set_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "task_actual_by_node_id": {
          "$ref": "#/$defs/taskActualMap",
          "description": "Exact map for every planned executable leaf except publisher_closure.task_node_id. P supplies the sole missing publisher actual."
        },
        "task_variance_by_node_id": {
          "$ref": "#/$defs/taskVarianceMap",
          "description": "Exact map for every planned executable leaf except publisher_closure.task_node_id. P supplies the sole missing publisher variance."
        },
        "milestone_variances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/milestoneVariance"
          },
          "uniqueItems": true
        },
        "resource_window_variances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceWindowVariance"
          },
          "uniqueItems": true
        },
        "dependency_critical_path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "resource_levelled_driving_path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "forecast_error": {
          "$ref": "#/$defs/forecastError"
        },
        "unmaterialized_scenario_dispositions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenarioDisposition"
          },
          "uniqueItems": true
        },
        "variance_reason_by_id": {
          "$ref": "#/$defs/varianceReasonMap"
        },
        "publisher_closure": {
          "$ref": "#/$defs/publisherClosure"
        },
        "reconciled_at": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/exactArtifactRef"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reconciliation_revision": {
                "const": 1
              }
            },
            "required": [
              "reconciliation_revision"
            ]
          },
          "then": {
            "properties": {
              "predecessor_reconciliation_sha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "predecessor_reconciliation_sha256": {
                "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
              }
            }
          }
        }
      ]
    },
    "nullableFinalReconciliation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/finalReconciliation"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": [
          "revision"
        ]
      },
      "then": {
        "properties": {
          "predecessor_sha256": {
            "type": "null"
          },
          "artifacts": {
            "properties": {
              "owner_assignment": {
                "properties": { "revision": { "const": 1 } }
              },
              "resource_calendar": {
                "properties": { "revision": { "const": 1 } }
              },
              "delivery_wbs": {
                "properties": { "revision": { "const": 1 } }
              },
              "forecast_snapshot": {
                "properties": { "revision": { "const": 1 } }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "predecessor_sha256": {
            "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "ACCEPTED"
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "properties": {
          "planning_bundle_approval_by_role": {
            "$ref": "#/$defs/acceptedPlanningApprovalByRole"
          }
        }
      },
      "else": {
        "properties": {
          "planning_bundle_approval_by_role": {
            "$ref": "#/$defs/emptyPlanningApprovalByRole"
          }
        }
      }
    },
    {
      "if": { "properties": { "planning_gate": { "const": "M0" } }, "required": ["planning_gate"] },
      "then": {
        "properties": {
          "detail_horizon": { "properties": { "planning_gate": { "const": "M0" }, "executable_through_gate": { "const": "M1" }, "next_expansion_gate": { "const": "M1" } } },
          "bundle_kind": { "const": "ROLLING_WAVE" },
          "final_actual_variance_reconciliation": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "planning_gate": { "const": "M1" } }, "required": ["planning_gate"] },
      "then": {
        "properties": {
          "detail_horizon": { "properties": { "planning_gate": { "const": "M1" }, "executable_through_gate": { "const": "M2" }, "next_expansion_gate": { "const": "M2" } } },
          "bundle_kind": { "const": "ROLLING_WAVE" },
          "final_actual_variance_reconciliation": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "planning_gate": { "const": "M2" } }, "required": ["planning_gate"] },
      "then": {
        "properties": {
          "detail_horizon": { "properties": { "planning_gate": { "const": "M2" }, "executable_through_gate": { "const": "M3" }, "next_expansion_gate": { "const": "M3" } } },
          "bundle_kind": { "const": "ROLLING_WAVE" },
          "final_actual_variance_reconciliation": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "planning_gate": { "const": "M3" } }, "required": ["planning_gate"] },
      "then": {
        "properties": {
          "detail_horizon": { "properties": { "planning_gate": { "const": "M3" }, "executable_through_gate": { "const": "M4" }, "next_expansion_gate": { "const": "M4" } } },
          "bundle_kind": { "const": "ROLLING_WAVE" },
          "final_actual_variance_reconciliation": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "planning_gate": { "const": "M4" } }, "required": ["planning_gate"] },
      "then": {
        "properties": {
          "detail_horizon": { "properties": { "planning_gate": { "const": "M4" }, "executable_through_gate": { "const": "M5" }, "next_expansion_gate": { "const": "M5" } } },
          "bundle_kind": { "const": "ROLLING_WAVE" },
          "final_actual_variance_reconciliation": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "planning_gate": { "const": "M5" } }, "required": ["planning_gate"] },
      "then": {
        "properties": {
          "detail_horizon": { "properties": { "planning_gate": { "const": "M5" }, "executable_through_gate": { "const": "M5" }, "next_expansion_gate": { "type": "null" } } },
          "revision": { "type": "integer", "minimum": 2 },
          "bundle_kind": { "const": "FINAL_ACTUAL_VARIANCE" },
          "final_actual_variance_reconciliation": { "$ref": "#/$defs/finalReconciliation" },
          "overall_status": { "const": "ACCEPTED" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_id": {
            "const": "M0-GOV-01-governed-delivery-planning-bundle"
          },
          "revision": {
            "const": 1
          }
        },
        "required": [
          "artifact_id",
          "revision"
        ]
      },
      "then": {
        "required": [
          "planning_approval_subject_ref"
        ],
        "properties": {
          "predecessor_sha256": {
            "type": "null"
          },
          "source_refs": {
            "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/governedPhaseBPlanningRootSourceRefs"
          },
          "planning_bundle_approval_by_role": {
            "$ref": "#/$defs/completeBootstrapPlanningApprovalByRole"
          }
        }
      },
      "else": {
        "properties": {
          "planning_approval_subject_ref": false,
          "planning_bundle_approval_by_role": {
            "$ref": "#/$defs/legacyPlanningApprovalByRole"
          }
        }
      }
    }
  ]
}
