{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/release-incident-v1.schema.json",
  "title": "YLX immutable release distribution incident v1",
  "description": "An append-only incident record against one exact finalized release and one exact distribution channel head. Incident revisions form a direct predecessor chain and cannot rewrite release completion, the finalized terminal slot, or an earlier distribution control.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "incident_id",
    "root_incident_id",
    "revision",
    "predecessor_incident_ref",
    "finalized_release_binding",
    "channel_binding",
    "triggering_control_ref",
    "declaration_assignment_ref",
    "incident_kind",
    "severity",
    "status",
    "detected_at",
    "declared_at",
    "summary",
    "impact",
    "required_distribution_action",
    "containment",
    "detection_evidence_refs",
    "artifact_metadata"
  ],
  "properties": {
    "schema": {
      "const": "ylx.release-incident.v1"
    },
    "incident_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "root_incident_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor_incident_ref": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/releaseIncidentRef" }
      ]
    },
    "finalized_release_binding": {
      "$ref": "https://schemas.ylx.invalid/governance/release-operation-assignment-v2.schema.json#/$defs/finalizedReleaseBinding"
    },
    "channel_binding": {
      "$ref": "https://schemas.ylx.invalid/governance/release-operation-assignment-v2.schema.json#/$defs/channelBinding"
    },
    "triggering_control_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/release-operation-assignment-v2.schema.json#/$defs/distributionControlRef"
    },
    "declaration_assignment_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/release-operation-assignment-v2.schema.json#/$defs/releaseOperationAssignmentRef",
      "description": "The exact v2 assignment must authorize DECLARE_INCIDENT and bind this incident_id, finalized release, channel, and triggering predecessor control procedurally."
    },
    "incident_kind": {
      "enum": [
        "RELEASE_DEFECT",
        "SECURITY_COMPROMISE",
        "DATA_COMPATIBILITY_FAILURE",
        "CHANNEL_AUTHORITY_MISMATCH",
        "INVALID_TERMINAL_READBACK",
        "DISTRIBUTION_CONTROL_CORRUPTION"
      ]
    },
    "severity": {
      "enum": ["SEV1", "SEV2", "SEV3", "SEV4"]
    },
    "status": {
      "enum": ["OPEN", "INVESTIGATING", "MITIGATING"]
    },
    "detected_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "declared_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "impact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "required_distribution_action": {
      "enum": ["WITHDRAWN", "REDIRECTED", "KEEP_QUARANTINED"]
    },
    "containment": {
      "$ref": "#/$defs/containment"
    },
    "detection_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
      }
    },
    "artifact_metadata": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactMetadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "revision": { "const": 1 } },
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "predecessor_incident_ref": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "revision": { "type": "integer", "minimum": 2 },
          "predecessor_incident_ref": { "$ref": "#/$defs/releaseIncidentRef" }
        }
      }
    }
  ],
  "$defs": {
    "releaseIncidentRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "required": ["revision"],
          "properties": {
            "schema": { "const": "ylx.release-incident.v1" }
          }
        }
      ]
    },
    "containment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_visibility",
        "producer_writes",
        "consumer_reads",
        "existing_data_disposition",
        "finalized_history_mutation"
      ],
      "properties": {
        "customer_visibility": {
          "enum": ["WITHDRAW", "REDIRECT", "KEEP_QUARANTINED"]
        },
        "producer_writes": {
          "enum": ["STOP", "ROLLBACK", "NO_CHANGE"]
        },
        "consumer_reads": {
          "enum": ["DUAL_READ_REQUIRED", "TARGET_ONLY", "LEGACY_ONLY"]
        },
        "existing_data_disposition": {
          "const": "PRESERVE_EXISTING_DATA"
        },
        "finalized_history_mutation": {
          "const": "FORBIDDEN"
        }
      }
    }
  }
}
