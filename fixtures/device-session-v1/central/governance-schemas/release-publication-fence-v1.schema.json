{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/release-publication-fence-v1.schema.json",
  "title": "YLX immutable single-attempt release publication fence v1",
  "description": "Acquired create-if-absent after quorum and before GA promotion. ACTIVE is derived solely from the absence of a closed terminal-slot reference; an orphan terminal payload does not change attempt state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attempt_id",
    "fence_authority_id",
    "pre_release_closure_ref",
    "pre_release_closure_sha256",
    "domain_attestation_sha256_by_role_slot",
    "quorum_signature_sha256_by_role_slot",
    "role_assignment_by_role_slot",
    "binding_context_ref",
    "contract_release_sha256",
    "product_contract_sha256",
    "qualification_governance_contract_sha256",
    "fresh_issue_head",
    "signing_policy_sha256",
    "key_validity_revocation_head_sha256",
    "quorum_policy_sha256",
    "ga_promotion_plan_ref",
    "ga_promotion_plan_sha256",
    "planned_promotion_operator",
    "release_train",
    "system_milestone",
    "rc_version",
    "rc_commit",
    "rc_artifact_sha256",
    "canonical_remote_id",
    "ga_ref",
    "ga_channel",
    "canonical_ga_target",
    "attempt_terminal_slot",
    "initial_customer_visibility",
    "required_key_validity_horizon_seconds",
    "acquired_at",
    "fence_semantics"
  ],
  "properties": {
    "schema": {
      "const": "ylx.release-publication-fence.v1"
    },
    "attempt_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "fence_authority_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "pre_release_closure_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
    },
    "pre_release_closure_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "domain_attestation_sha256_by_role_slot": {
      "$ref": "https://schemas.ylx.invalid/governance/pre-release-closure-v1.schema.json#/$defs/domainAttestationMap"
    },
    "quorum_signature_sha256_by_role_slot": {
      "$ref": "https://schemas.ylx.invalid/governance/release-closure-manifest-v1.schema.json#/$defs/quorumMap"
    },
    "role_assignment_by_role_slot": {
      "$ref": "#/$defs/roleAssignmentMap"
    },
    "binding_context_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
    },
    "contract_release_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "product_contract_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "qualification_governance_contract_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "fresh_issue_head": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/issueHead"
    },
    "signing_policy_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "key_validity_revocation_head_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "quorum_policy_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "ga_promotion_plan_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
    },
    "ga_promotion_plan_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "planned_promotion_operator": {
      "$ref": "https://schemas.ylx.invalid/governance/ga-promotion-plan-v1.schema.json#/$defs/plannedOperator"
    },
    "release_train": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "system_milestone": {
      "const": "0.5"
    },
    "rc_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-[0-9A-Za-z.-]+$"
    },
    "rc_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "rc_artifact_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "canonical_remote_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "ga_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "ga_channel": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "canonical_ga_target": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "attempt_terminal_slot": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "initial_customer_visibility": {
      "const": "QUARANTINED"
    },
    "required_key_validity_horizon_seconds": {
      "type": "integer",
      "minimum": 60
    },
    "acquired_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "fence_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition",
        "active_derivation",
        "parallel_attempts",
        "ordinary_authority_successors",
        "emergency_revocation",
        "ga_visibility",
        "recovery",
        "release_condition",
        "missing_manifest_state",
        "orphan_final_payload_state",
        "finalized_state",
        "aborted_state",
        "pre_finalized_cas_freshness_mismatch",
        "post_finalized_cas_pre_readback_freshness_mismatch"
      ],
      "properties": {
        "acquisition": {
          "const": "CREATE_IF_ABSENT_SINGLE_ATTEMPT"
        },
        "active_derivation": {
          "const": "TERMINAL_SLOT_ABSENT"
        },
        "parallel_attempts": {
          "const": "FORBIDDEN"
        },
        "ordinary_authority_successors": {
          "const": "BLOCKED_WHILE_ACTIVE"
        },
        "emergency_revocation": {
          "const": "TERMINATE_ATTEMPT_AND_KEEP_GA_QUARANTINED"
        },
        "ga_visibility": {
          "const": "QUARANTINED_UNTIL_VALID_ACTIVE_DISTRIBUTION_HEAD"
        },
        "recovery": {
          "const": "SAME_IMMUTABLE_INPUTS_ONLY"
        },
        "release_condition": {
          "const": "FINAL_MANIFEST_PAYLOAD_AND_FINALIZED_SLOT_REFERENCE_DURABLE_EXACT_READBACK"
        },
        "missing_manifest_state": {
          "const": "RELEASE_NOT_COMPLETE"
        },
        "orphan_final_payload_state": {
          "const": "FINAL_PAYLOAD_DURABLE_NOT_ACTIVATED"
        },
        "finalized_state": {
          "const": "FINAL_REFERENCE_DURABLE"
        },
        "aborted_state": {
          "const": "ABORTED_REFERENCE_DURABLE"
        },
        "pre_finalized_cas_freshness_mismatch": {
          "const": "ABORTED_AND_QUARANTINED"
        },
        "post_finalized_cas_pre_readback_freshness_mismatch": {
          "const": "IMMUTABLE_INVALID_TERMINAL_NO_PASS_NO_RELEASE_COMPLETE_NO_OVERWRITE_OR_REUSE"
        }
      }
    }
  },
  "$defs": {
    "roleAssignmentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_id",
        "assignment_artifact_sha256",
        "assignment_revision"
      ],
      "properties": {
        "person_id": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
        },
        "assignment_artifact_sha256": {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
        },
        "assignment_revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "roleAssignmentMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release-owner",
        "contract-owner",
        "security-owner",
        "qa-evidence-owner"
      ],
      "properties": {
        "release-owner": { "$ref": "#/$defs/roleAssignmentBinding" },
        "contract-owner": { "$ref": "#/$defs/roleAssignmentBinding" },
        "security-owner": { "$ref": "#/$defs/roleAssignmentBinding" },
        "qa-evidence-owner": { "$ref": "#/$defs/roleAssignmentBinding" }
      }
    }
  }
}
