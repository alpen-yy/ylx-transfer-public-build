{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/g0-external-approval-v1.schema.json",
  "title": "YLX external approval record for one G0 ratification subject v1",
  "description": "One signed external response to an exact request for an exact four-key subject. The record itself has no authority effect; only a complete valid G0 F/P/R tuple may consume an eligible APPROVE_PROSPECTIVE_ONLY record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "approval_id",
    "subject_ref",
    "subject_sha256",
    "external_authority_ref",
    "external_authority_sha256",
    "quorum_policy_ref",
    "quorum_policy_sha256",
    "role_id",
    "approver_person_id",
    "decision",
    "approved_at",
    "valid_until",
    "request_send_receipt_ref",
    "request_send_receipt_sha256",
    "response_channel",
    "response_channel_message_id",
    "received_at",
    "authority_effect",
    "signature_algorithm",
    "signing_key_id",
    "signed_payload_sha256",
    "signature"
  ],
  "properties": {
    "schema": {"const": "ylx.g0-external-approval.v1"},
    "approval_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"},
    "subject_ref": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "subject_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "external_authority_ref": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "external_authority_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "quorum_policy_ref": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "quorum_policy_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "role_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/roleId"},
    "approver_person_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "decision": {"enum": ["APPROVE_PROSPECTIVE_ONLY", "REJECT", "ABSTAIN"]},
    "approved_at": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"},
    "valid_until": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"},
    "request_send_receipt_ref": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "request_send_receipt_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "response_channel": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "response_channel_message_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "received_at": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"},
    "authority_effect": {"const": "NONE"},
    "signature_algorithm": {"const": "Ed25519"},
    "signing_key_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "signed_payload_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "signature": {"type": "string", "minLength": 88, "maxLength": 88, "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$"}
  }
}
