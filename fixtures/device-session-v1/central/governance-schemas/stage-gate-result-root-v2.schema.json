{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/stage-gate-result-root-v2.schema.json",
  "title": "YLX stage gate result root v2",
  "description": "Immutable per-gate selection root with a stable root_id, an exact direct-predecessor revision chain, and exact references to the selected terminal-result tips. A successor root replaces no bytes and may advance only through its exact direct predecessor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "root_id",
    "revision",
    "predecessor_root_ref",
    "closing_gate",
    "registry_sha256",
    "requirement_id_set_sha256",
    "source_scope_ref",
    "selected_result_ref_by_requirement_id",
    "selection_algorithm",
    "selection_version",
    "created_at",
    "artifact_metadata"
  ],
  "properties": {
    "schema": {
      "const": "ylx.stage-gate-result-root.v2"
    },
    "root_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId",
      "description": "Stable identity for one closing gate and native source-scope lineage."
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor_root_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/stageGateResultRootRef"
        }
      ],
      "description": "Exact direct predecessor. Its artifact_id equals root_id and its revision is exactly this revision minus one."
    },
    "closing_gate": {
      "$ref": "#/$defs/closingGate"
    },
    "registry_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "requirement_id_set_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256",
      "description": "Canonical sorted-key-set digest of selected_result_ref_by_requirement_id keys."
    },
    "source_scope_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef",
      "description": "Exact native scope: stage-source-scope.v1 for M0/M1, or binding-context.v2 for M2 and later gates."
    },
    "selected_result_ref_by_requirement_id": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^[A-Z0-9][A-Z0-9-]+$": {
          "$ref": "#/$defs/stageTerminalResultRef"
        }
      },
      "description": "Exact current terminal-result tip for every requirement selected by this gate root. Each ref resolves to the same requirement_id, closing_gate, and source_scope_ref as its map key and this root."
    },
    "selection_algorithm": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "selection_version": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "created_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "artifact_metadata": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactMetadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": [
          "revision"
        ]
      },
      "then": {
        "properties": {
          "predecessor_root_ref": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 2
          },
          "predecessor_root_ref": {
            "$ref": "#/$defs/stageGateResultRootRef"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "closing_gate": {
            "enum": [
              "M0",
              "M1"
            ]
          }
        },
        "required": [
          "closing_gate"
        ]
      },
      "then": {
        "properties": {
          "source_scope_ref": {
            "$ref": "#/$defs/stageSourceScopeRef"
          }
        }
      },
      "else": {
        "properties": {
          "source_scope_ref": {
            "$ref": "#/$defs/bindingContextRef"
          }
        }
      }
    }
  ],
  "$defs": {
    "closingGate": {
      "enum": [
        "M0",
        "M1",
        "M2",
        "M3",
        "M4a",
        "M4b",
        "M4c",
        "M4d",
        "M4",
        "M5"
      ]
    },
    "bindingContextRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.binding-context.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "stageSourceScopeRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.stage-source-scope.v1"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "stageTerminalResultRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.stage-terminal-result.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    },
    "stageGateResultRootRef": {
      "allOf": [
        {
          "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "schema": {
              "const": "ylx.stage-gate-result-root.v2"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "schema",
            "revision"
          ]
        }
      ]
    }
  }
}
