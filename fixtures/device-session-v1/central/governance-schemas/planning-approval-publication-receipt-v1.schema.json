{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/planning-approval-publication-receipt-v1.schema.json",
  "title": "YLX planning approval publication receipt P v1",
  "description": "Signed append-only external terminal receipt for create-if-absent publication of one exact unrevisioned ylx.planning-bundle-approval.v1 record. The signed payload is RFC 8785 canonical JSON UTF-8 over every field except signed_payload_sha256 and signature, under domain YLX-PLANNING-BOOTSTRAP-TERMINAL-RECEIPT-V1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "approval_id",
    "role_id",
    "approval_ref",
    "approval_sha256",
    "actor_id",
    "write_operation_authority_ref",
    "write_operation_authority_sha256",
    "repository_permission_ref",
    "repository_permission_sha256",
    "repository_locator",
    "target_scope",
    "byte_length",
    "published_at",
    "create_result",
    "fsync_result",
    "terminal_sink_id",
    "receipt_issuer_id",
    "signature_algorithm",
    "signing_key_id",
    "signed_payload_sha256",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "ylx.planning-approval-publication-receipt.v1"
    },
    "receipt_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "approval_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"
    },
    "role_id": {
      "enum": [
        "release-owner",
        "build-platform-owner",
        "qa-evidence-owner"
      ]
    },
    "approval_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "approval_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "actor_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "write_operation_authority_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "write_operation_authority_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "repository_permission_ref": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "repository_permission_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "repository_locator": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "target_scope": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"
    },
    "byte_length": {
      "type": "integer",
      "minimum": 2
    },
    "published_at": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"
    },
    "create_result": {
      "enum": [
        "CREATED_EXACT",
        "ALREADY_EXACT"
      ]
    },
    "fsync_result": {
      "const": "FILE_AND_PARENT_DIRECTORY_DURABLE"
    },
    "terminal_sink_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "receipt_issuer_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "signature_algorithm": {
      "const": "Ed25519"
    },
    "signing_key_id": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"
    },
    "signed_payload_sha256": {
      "$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"
    },
    "signature": {
      "description": "Canonical padded RFC 4648 base64 encoding of exactly 64 Ed25519 signature bytes.",
      "type": "string",
      "minLength": 88,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$"
    }
  }
}
