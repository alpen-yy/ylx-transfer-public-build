{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ylx.invalid/governance/g0-policy-ratification-publication-receipt-v1.schema.json",
  "title": "YLX G0 event publication receipt P v1",
  "description": "Signed external terminal receipt for the create-if-absent publication of one exact G0 event F. It binds the real publisher, publisher authority, per-write repository permission, target, bytes, and durability result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "event_id",
    "event_revision",
    "subject_sha256",
    "publisher_id",
    "publisher_authority_ref",
    "publisher_authority_sha256",
    "repository_permission_ref",
    "repository_permission_sha256",
    "repository_locator",
    "operation",
    "target_scope",
    "event_ref",
    "event_sha256",
    "byte_length",
    "published_at",
    "create_result",
    "fsync_result",
    "terminal_sink_id",
    "receipt_issuer_id",
    "signature_algorithm",
    "signing_key_id",
    "signed_payload_sha256",
    "signature"
  ],
  "properties": {
    "schema": {"const": "ylx.g0-policy-ratification-publication-receipt.v1"},
    "receipt_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"},
    "event_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/artifactId"},
    "event_revision": {"type": "integer", "minimum": 1},
    "subject_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "publisher_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "publisher_authority_ref": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "publisher_authority_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "repository_permission_ref": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "repository_permission_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "repository_locator": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "operation": {"const": "CREATE_IF_ABSENT"},
    "target_scope": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "event_ref": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/stableLocator"},
    "event_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "byte_length": {"type": "integer", "minimum": 2},
    "published_at": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/timestamp"},
    "create_result": {"enum": ["CREATED_EXACT", "ALREADY_EXACT"]},
    "fsync_result": {"const": "FILE_AND_PARENT_DIRECTORY_DURABLE"},
    "terminal_sink_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "receipt_issuer_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "signature_algorithm": {"const": "Ed25519"},
    "signing_key_id": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/identifier"},
    "signed_payload_sha256": {"$ref": "https://schemas.ylx.invalid/governance/governance-common.schema.json#/$defs/sha256"},
    "signature": {"type": "string", "minLength": 88, "maxLength": 88, "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$"}
  }
}
